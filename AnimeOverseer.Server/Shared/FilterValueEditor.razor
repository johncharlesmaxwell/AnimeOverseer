@using System.Globalization
@using AnimeOverseer.Server.Models
@using AnimeOverseer.Server.Services.Expressions
@inject AnimeOverseer.Server.Services.AnimeCacheService AnimeCacheService

<div class="filter-value-editor">
    @if (UseOptionSet && !IsFormula(Value))
    {
        <select class="form-select condition-value" value="@Value" @onchange="ChangeValue">
            <option value="">@Placeholder</option>
            @foreach (var option in Suggestions) { <option value="@option">@option</option> }
            @if (!string.IsNullOrEmpty(Value) && !Suggestions.Contains(Value)) { <option value="@Value">@Value</option> }
        </select>
    }
    else
    {
        <input class="form-input condition-value" type="@(UseDatePicker && !IsFormula(Value) ? "date" : "text")"
               list="@(UseDatePicker || IsFormula(Value) ? null : ListId)" placeholder="@Placeholder" value="@Value" @oninput="ChangeValue" />
        @if (Suggestions.Count > 0 && !UseDatePicker && !IsFormula(Value))
        {
            <datalist id="@ListId">@foreach (var suggestion in Suggestions) { <option value="@suggestion" /> }</datalist>
        }
    }
    @if (AllowDynamicExpressions)
    {
        <button type="button" class="formulae-button" title="Build a formula" aria-label="Build a formula" @onclick="OpenDialogAsync"><span class="formulae-icon" aria-hidden="true">{{𝑓}}</span></button>
    }
</div>

@if (isOpen)
{
    <div class="formula-dialog-backdrop" @onclick="CloseDialog">
        <section class="formula-dialog formula-dialog--composer" role="dialog" aria-modal="true" aria-labelledby="formula-dialog-title" @onclick:stopPropagation="true">
            <header>
                <div>
                    <h3 id="formula-dialog-title">Build dynamic value</h3>
                    <p>Start with a field or example, then add compatible operations. Every colour also has a type label and icon.</p>
                </div>
                <button class="condition-remove" title="Close" aria-label="Close formula builder" @onclick="CloseDialog">✕</button>
            </header>

            <div class="formula-editor-tabs" role="tablist" aria-label="Formula editing mode">
                <button type="button" role="tab" aria-selected="@(editorMode == "guided")" class="@(editorMode == "guided" ? "active" : "")"
                        disabled="@(editorMode != "guided" && DraftError is not null)" title="Fix source errors before returning to guided mode"
                        @onclick="SetGuidedMode">Guided</button>
                <button type="button" role="tab" aria-selected="@(editorMode == "code")" class="@(editorMode == "code" ? "active" : "")"
                        @onclick="SetCodeMode">Formula code</button>
            </div>

            @if (editorMode == "guided")
            {
                <section class="formula-examples" aria-labelledby="formula-examples-title">
                    <div class="formula-section-heading">
                        <div><strong id="formula-examples-title">Start from an example</strong><small>Uses the same parser and validation as saved filters.</small></div>
                    </div>
                    <div class="formula-example-list">
                        @foreach (var example in FilterExpressionCatalog.Examples)
                        {
                            <button type="button" @onclick="() => UseExample(example)">
                                <strong>@example.Name</strong><span>@example.Description</span>
                            </button>
                        }
                    </div>
                </section>

                <div class="formula-composer-grid">
                    <aside class="formula-catalog" aria-label="Formula fields and functions">
                        <label class="sr-only" for="@SearchId">Search fields and functions</label>
                        <input id="@SearchId" class="form-input" type="search" placeholder="Search fields and functions…"
                               @bind="catalogSearch" @bind:event="oninput" />

                        <div class="formula-dialog-section">
                            <strong>Values</strong>
                            <div class="formula-value-shortcuts" aria-label="Insert a value">
                                <button type="button" disabled="@(!CanReplaceSelectedWith(TextLiteral()))" @onclick="() => ReplaceSelected(TextLiteral())">Text</button>
                                <button type="button" disabled="@(!CanReplaceSelectedWith(NumberLiteral()))" @onclick="() => ReplaceSelected(NumberLiteral())">Number</button>
                                <button type="button" disabled="@(!CanReplaceSelectedWith(BooleanLiteral()))" @onclick="() => ReplaceSelected(BooleanLiteral())">True/false</button>
                                <button type="button" disabled="@(!CanReplaceSelectedWith(EmptyList()))" @onclick="() => ReplaceSelected(EmptyList())">List</button>
                            </div>
                        </div>

                        <div class="formula-dialog-section">
                            <strong>Anime fields</strong>
                            <div class="formula-token-list formula-token-list--vertical">
                                @foreach (var field in FilteredFields)
                                {
                                    var canUseField = CanReplaceSelectedWith(new FieldExpression { Name = field.Name });
                                    <button type="button" class="expression-palette-item @FilterExpressionCatalog.TypeCssClass(field.Type)"
                                            disabled="@(!canUseField)" draggable="@canUseField" @ondragstart="() => BeginDragField(field.Name)" @onclick="() => SetField(field.Name)"
                                            title="@(canUseField ? field.Description : $"{field.Description}. It is not compatible with the selected slot.")">
                                        <span class="expression-node-icon" aria-hidden="true">@FilterExpressionCatalog.TypeIcon(field.Type)</span>
                                        <span><strong>@field.Label</strong><small>@field.Description</small></span>
                                        <em>@FilterExpressionCatalog.TypeLabel(field.Type)</em>
                                    </button>
                                }
                            </div>
                        </div>

                        @foreach (var group in FilteredFunctions.GroupBy(function => function.Category))
                        {
                            <div class="formula-dialog-section">
                                <strong>@group.Key</strong>
                                <div class="formula-token-list formula-token-list--vertical">
                                    @foreach (var function in group)
                                    {
                                        var canApply = CanApply(function);
                                        <button type="button" class="expression-palette-item @FunctionTypeClass(function)" disabled="@(!canApply)"
                                                draggable="@canApply" @ondragstart="() => BeginDragFunction(function.Name)" @onclick="() => ApplyFunction(function)"
                                                title="@(canApply ? function.Description : $"{function.Description}. It is not compatible with the current output type.")">
                                            <span class="expression-node-icon" aria-hidden="true">𝑓</span>
                                            <span><strong>@function.Label</strong><small>@function.Description</small></span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </aside>

                    <main class="formula-workspace">
                        <div class="formula-section-heading">
                            <div><strong>Your formula</strong><small>Select a node, then replace or wrap it from the palette.</small></div>
                            <button type="button" class="btn btn-small" disabled="@(undoDrafts.Count == 0)" @onclick="Undo">Undo</button>
                        </div>
                        <div class="expression-canvas @(draggedKind is null ? "" : "expression-canvas--drop-ready")"
                             @ondragover:preventDefault @ondrop="DropOnCanvas">
                            @if (CurrentNode is ExpressionNode root)
                            {
                                <ExpressionNodeView Node="root" SelectedPath="@selectedPath" OnSelect="SelectNode" />
                            }
                            else
                            {
                                <p>Choose a field or example to begin.</p>
                            }
                        </div>
                        @if (SelectedNode is ExpressionNode selected)
                        {
                            <section class="expression-selection-editor" aria-labelledby="selected-node-heading">
                                <div class="expression-selection-heading">
                                    <div>
                                        <strong id="selected-node-heading">Selected: @SelectedNodeLabel(selected)</strong>
                                        <small>Palette choices now apply here.</small>
                                    </div>
                                    <div class="expression-selection-actions">
                                        <button type="button" class="btn btn-small" disabled="@(!CanMoveSelected(-1))" title="Move argument up" aria-label="Move selected argument up" @onclick="() => MoveSelected(-1)">↑</button>
                                        <button type="button" class="btn btn-small" disabled="@(!CanMoveSelected(1))" title="Move argument down" aria-label="Move selected argument down" @onclick="() => MoveSelected(1)">↓</button>
                                        <button type="button" class="btn btn-small" disabled="@(!CanRemoveSelected())" @onclick="RemoveSelected">Remove</button>
                                    </div>
                                </div>

                                @if (selected is LiteralExpression literal)
                                {
                                    <label for="@LiteralEditorId">Value</label>
                                    @if (literal.ValueType == ExpressionValueType.Boolean)
                                    {
                                        <select id="@LiteralEditorId" class="form-select" value="@literal.Value" @onchange="ChangeLiteralValue">
                                            <option value="False">False</option>
                                            <option value="True">True</option>
                                        </select>
                                    }
                                    else if (literal.ValueType == ExpressionValueType.Null)
                                    {
                                        <p class="formula-preview-muted">This is an empty value. Choose another value or field from the palette to replace it.</p>
                                    }
                                    else
                                    {
                                        <input id="@LiteralEditorId" class="form-input" type="@(literal.ValueType == ExpressionValueType.Number ? "number" : "text")"
                                               step="@(literal.ValueType == ExpressionValueType.Number ? "any" : null)" value="@literal.Value" @onchange="ChangeLiteralValue" />
                                        @if (SelectedFormatPresets.Count > 0)
                                        {
                                            <div class="expression-format-picker">
                                                <div class="expression-format-picker-heading">
                                                    <strong>Format presets</strong>
                                                    <small>Choose a complete format or build one from parts.</small>
                                                </div>
                                                <div class="expression-format-options" aria-label="Format presets">
                                                    @foreach (var preset in SelectedFormatPresets)
                                                    {
                                                        <button type="button" class="@(literal.Value == preset.Value ? "active" : "")" title="@preset.Description"
                                                                @onclick="() => SetFormat(preset.Value)">
                                                            <span>@preset.Label</span><code>@(preset.Value.Length == 0 ? "default" : preset.Value)</code>
                                                        </button>
                                                    }
                                                </div>
                                                <span class="expression-format-parts-label">Add format part</span>
                                                <div class="expression-format-parts" aria-label="Format parts">
                                                    @foreach (var part in SelectedFormatParts)
                                                    {
                                                        <button type="button" title="@part.Description" @onclick="() => AppendFormatPart(part.Value)"><code>@part.Label</code></button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    <p>Choose a compatible field or value to replace this node, or choose a function to wrap it.</p>
                                }

                                @if (selected is FunctionExpression selectedFunction && CanAddArgument(selectedFunction))
                                {
                                    <button type="button" class="btn btn-small expression-add-argument" @onclick="AddArgument">+ Add argument</button>
                                }
                            </section>
                        }
                        <div class="formula-source-summary">
                            <span>Generated formula</span><code>@InnerExpression()</code>
                        </div>
                        @if (CurrentType is ExpressionValueType outputType)
                        {
                            <span class="expression-output-type @FilterExpressionCatalog.TypeCssClass(outputType)">
                                <span aria-hidden="true">@FilterExpressionCatalog.TypeIcon(outputType)</span> Returns @FilterExpressionCatalog.TypeLabel(outputType).ToLowerInvariant()
                            </span>
                        }
                    </main>

                    <aside class="formula-preview" aria-live="polite">
                        <div class="formula-section-heading"><div><strong>Live preview</strong><small>Evaluated locally against catalogue data.</small></div></div>
                        @if (previewLoading)
                        {
                            <p class="formula-preview-muted">Loading examples…</p>
                        }
                        else if (previewAnimes.Count == 0)
                        {
                            <p class="formula-preview-muted">No catalogue anime are available for a preview yet.</p>
                        }
                        else
                        {
                            <label for="@PreviewId">Example anime</label>
                            <select id="@PreviewId" class="form-select" value="@previewAnimeId" @onchange="ChangePreviewAnime">
                                @foreach (var anime in previewAnimes) { <option value="@anime.Id">@anime.Title</option> }
                            </select>

                            var preview = BuildPreview();
                            <div class="formula-preview-result @(preview.Success ? "formula-preview-result--valid" : "formula-preview-result--error")">
                                <span>@(preview.Success ? "Result" : "Preview")</span>
                                <strong>@preview.Text</strong>
                                @if (preview.Type is ExpressionValueType previewType)
                                {
                                    <small>@FilterExpressionCatalog.TypeLabel(previewType)</small>
                                }
                            </div>

                            @if (ReferencedFields.Count > 0)
                            {
                                <dl class="formula-preview-inputs">
                                    @foreach (var field in ReferencedFields)
                                    {
                                        <div><dt>@field.Label</dt><dd>@PreviewFieldValue(field)</dd></div>
                                    }
                                </dl>
                            }
                            @if (ReferencedFields.Any(field => field.Name.Equals("inLibrary", StringComparison.OrdinalIgnoreCase)))
                            {
                                <small class="formula-preview-muted">Library status is shown as “No” in formula previews.</small>
                            }
                        }
                    </aside>
                </div>
            }
            else
            {
                <div class="formula-code-editor">
                    <label for="@CodeId"><strong>Formula source</strong></label>
                    <textarea id="@CodeId" class="form-input formula-dialog-input @(DraftError is null ? "" : "input-error")" rows="8"
                              value="@draft" @oninput="ChangeDraft" spellcheck="false"
                              placeholder="e.g. {{div(mul(episodes, duration), 60)}}"></textarea>
                    @if (DraftError is not null)
                    {
                        <div class="expression-code-error" role="alert"><strong>Fix this before applying:</strong> @DraftError</div>
                    }
                    else if (CurrentType is ExpressionValueType sourceType)
                    {
                        <div class="expression-code-valid @FilterExpressionCatalog.TypeCssClass(sourceType)">
                            <span aria-hidden="true">@FilterExpressionCatalog.TypeIcon(sourceType)</span>
                            Valid formula · returns @FilterExpressionCatalog.TypeLabel(sourceType).ToLowerInvariant()
                        </div>
                    }
                    <p>Fields are unquoted; text is quoted. Functions can be nested up to @FilterExpressionParser.MaximumDepth levels.</p>
                </div>
            }

            <footer>
                <span class="formula-dialog-status">@(DraftError is null ? "Ready to use" : "Formula needs attention")</span>
                <button class="btn" @onclick="CloseDialog">Cancel</button>
                <button class="btn btn-primary" disabled="@(DraftError is not null)" @onclick="ApplyAsync">Use value</button>
            </footer>
        </section>
    </div>
}

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool AllowDynamicExpressions { get; set; }
    [Parameter] public bool UseOptionSet { get; set; }
    [Parameter] public bool UseDatePicker { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Value…";
    [Parameter] public List<string> Suggestions { get; set; } = [];

    private readonly string ListId = $"filter-values-{Guid.NewGuid():N}";
    private readonly string SearchId = $"formula-search-{Guid.NewGuid():N}";
    private readonly string PreviewId = $"formula-preview-{Guid.NewGuid():N}";
    private readonly string CodeId = $"formula-code-{Guid.NewGuid():N}";
    private readonly string LiteralEditorId = $"formula-literal-{Guid.NewGuid():N}";
    private readonly Stack<string> undoDrafts = new();
    private readonly List<Anime> previewAnimes = [];
    private static readonly IReadOnlyList<FormatChoice> NumberFormatPresets =
    [
        new("Default", "", "Use the normal number representation"),
        new("Whole number", "0", "Always show at least one digit"),
        new("Two decimals", "0.00", "Always show two decimal places"),
        new("Grouped", "#,##0", "Use thousands separators"),
        new("Grouped + decimals", "#,##0.00", "Use thousands separators and two decimal places"),
        new("Percentage", "0.##%", "Multiply by 100 and add a percent sign"),
        new("Scientific", "0.###E+0", "Use scientific notation")
    ];
    private static readonly IReadOnlyList<FormatChoice> NumberFormatParts =
    [
        new("0", "0", "Required digit"), new("#", "#", "Optional digit"),
        new(".", ".", "Decimal point"), new(",", ",", "Digit grouping"),
        new("%", "%", "Percentage"), new("‰", "‰", "Per mille"),
        new("E+0", "E+0", "Scientific exponent")
    ];
    private static readonly IReadOnlyList<FormatChoice> DateFormatPresets =
    [
        new("Default", "", "Use the normal date representation"),
        new("ISO date", "yyyy-MM-dd", "Year-month-day"),
        new("Short friendly", "d MMM yyyy", "Day, abbreviated month, and year"),
        new("Full date", "dddd, d MMMM yyyy", "Weekday and full date"),
        new("24-hour time", "HH:mm", "Hours and minutes using a 24-hour clock"),
        new("Date and time", "yyyy-MM-dd HH:mm", "ISO-style date with hours and minutes")
    ];
    private static readonly IReadOnlyList<FormatChoice> DateFormatParts =
    [
        new("yyyy", "yyyy", "Four-digit year"), new("yy", "yy", "Two-digit year"),
        new("MMMM", "MMMM", "Full month name"), new("MMM", "MMM", "Abbreviated month name"), new("MM", "MM", "Two-digit month"),
        new("dd", "dd", "Two-digit day"), new("ddd", "ddd", "Abbreviated weekday"), new("dddd", "dddd", "Full weekday"),
        new("HH", "HH", "24-hour clock"), new("hh", "hh", "12-hour clock"),
        new("mm", "mm", "Minutes"), new("ss", "ss", "Seconds"), new("tt", "tt", "AM or PM"),
        new("-", "-", "Dash separator"), new("/", "/", "Date separator"), new(":", ":", "Time separator"),
        new(",", ",", "Comma"), new("space", " ", "Space")
    ];
    private bool isOpen;
    private bool previewLoading;
    private string editorMode = "guided";
    private string draft = string.Empty;
    private string catalogSearch = string.Empty;
    private string selectedPath = string.Empty;
    private string? draggedKind;
    private string? draggedValue;
    private int previewAnimeId;

    private string? DraftError
    {
        get
        {
            if (!IsFormula(draft)) return "A formula must be wrapped in {{ and }}.";
            var result = FilterExpressionParser.Parse(draft);
            if (!result.IsValid) return result.Diagnostics.FirstOrDefault()?.Message ?? "Invalid expression.";
            return FilterExpressionValidator.Validate(result.Root!).FirstOrDefault()?.Message;
        }
    }

    private ExpressionNode? CurrentNode
    {
        get
        {
            if (DraftError is not null) return null;
            return FilterExpressionParser.Parse(draft).Root;
        }
    }

    private ExpressionValueType? CurrentType => CurrentNode is ExpressionNode node ? FilterExpressionValidator.InferType(node) : null;
    private ExpressionNode? SelectedNode
    {
        get
        {
            if (CurrentNode is not ExpressionNode root) return null;
            return FilterExpressionTreeEditor.TryGet(root, selectedPath, out var selected) ? selected : root;
        }
    }
    private ExpressionValueType? SelectedType => SelectedNode is ExpressionNode node ? FilterExpressionValidator.InferType(node) : null;
    private ExpressionValueType? SelectedFormatValueType
    {
        get
        {
            if (CurrentNode is not ExpressionNode root ||
                !FilterExpressionTreeEditor.TryGetParent(root, selectedPath, out var parent, out var index) ||
                index != 1 || !parent.Name.Equals("string", StringComparison.OrdinalIgnoreCase) || parent.Arguments.Count == 0) return null;
            return FilterExpressionValidator.InferType(parent.Arguments[0]);
        }
    }
    private IReadOnlyList<FormatChoice> SelectedFormatPresets => SelectedFormatValueType switch
    {
        ExpressionValueType.Number => NumberFormatPresets,
        ExpressionValueType.DateTime => DateFormatPresets,
        _ => []
    };
    private IReadOnlyList<FormatChoice> SelectedFormatParts => SelectedFormatValueType switch
    {
        ExpressionValueType.Number => NumberFormatParts,
        ExpressionValueType.DateTime => DateFormatParts,
        _ => []
    };
    private Anime? SelectedPreviewAnime => previewAnimes.FirstOrDefault(anime => anime.Id == previewAnimeId) ?? previewAnimes.FirstOrDefault();

    private IReadOnlyList<ExpressionFieldDefinition> ReferencedFields => CurrentNode is null
        ? []
        : FindFieldNames(CurrentNode).Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(name => FilterExpressionCatalog.TryGetField(name, out var definition) ? definition : null)
            .Where(definition => definition is not null).Cast<ExpressionFieldDefinition>().ToList();

    private IEnumerable<ExpressionFieldDefinition> FilteredFields => FilterExpressionCatalog.Fields.Where(definition => MatchesSearch(definition.Name, definition.Label, definition.Description));
    private IEnumerable<ExpressionFunctionDefinition> FilteredFunctions => FilterExpressionCatalog.Functions
        .Where(function => !function.Name.Equals("array", StringComparison.OrdinalIgnoreCase))
        .Where(function => MatchesSearch(function.Name, function.Label, function.Description, function.Category));

    private static bool IsFormula(string value) => value.TrimStart().StartsWith("{{", StringComparison.Ordinal);
    private async Task ChangeValue(ChangeEventArgs args) => await ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private void SetGuidedMode() { editorMode = "guided"; selectedPath = string.Empty; }
    private void SetCodeMode() => editorMode = "code";

    private async Task OpenDialogAsync()
    {
        draft = IsFormula(Value) ? Value : string.IsNullOrWhiteSpace(Value) ? "{{title}}" : $"{{{{\"{Escape(Value)}\"}}}}";
        editorMode = DraftError is null ? "guided" : "code";
        catalogSearch = string.Empty;
        selectedPath = string.Empty;
        undoDrafts.Clear();
        isOpen = true;
        previewLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            previewAnimes.Clear();
            previewAnimes.AddRange(await AnimeCacheService.GetExpressionPreviewSamplesAsync());
            previewAnimeId = previewAnimes.FirstOrDefault()?.Id ?? 0;
        }
        finally
        {
            previewLoading = false;
        }
    }

    private void CloseDialog() => isOpen = false;

    private async Task ApplyAsync()
    {
        if (DraftError is null)
        {
            await ValueChanged.InvokeAsync(draft);
            isOpen = false;
        }
    }

    private void ChangeDraft(ChangeEventArgs args)
    {
        draft = args.Value?.ToString() ?? string.Empty;
        selectedPath = string.Empty;
    }

    private void SetField(string value) => ReplaceSelected(new FieldExpression { Name = value });
    private void UseExample(ExpressionExampleDefinition example)
    {
        selectedPath = string.Empty;
        SetDraft($"{{{{{example.Source}}}}}");
    }

    private void ApplyFunction(ExpressionFunctionDefinition function)
    {
        if (!CanApply(function)) return;
        var selected = SelectedNode;
        var source = function.ApplyTo(selected is null ? "title" : FilterExpressionParser.Format(selected));
        var parsed = FilterExpressionParser.Parse(source);
        if (parsed.IsValid) ReplaceSelected(parsed.Root!);
    }

    private bool CanApply(ExpressionFunctionDefinition function) =>
        DraftError is null && (!function.UsesCurrentValue || function.CanApplyTo(SelectedType)) &&
        FunctionCandidate(function) is ExpressionNode candidate && CanReplaceSelectedWith(candidate);

    private string FunctionTypeClass(ExpressionFunctionDefinition function)
    {
        if (!CanApply(function)) return "expression-type--empty";
        var type = FunctionCandidate(function) is ExpressionNode candidate ? FilterExpressionValidator.InferType(candidate) : null;
        return FilterExpressionCatalog.TypeCssClass(type);
    }

    private ExpressionNode? FunctionCandidate(ExpressionFunctionDefinition function)
    {
        var selected = SelectedNode;
        if (function.UsesCurrentValue && selected is null) return null;
        var parsed = FilterExpressionParser.Parse(function.ApplyTo(selected is null ? "title" : FilterExpressionParser.Format(selected)));
        return parsed.IsValid ? parsed.Root : null;
    }

    private void SetDraft(string value)
    {
        if (value == draft) return;
        undoDrafts.Push(draft);
        draft = value;
    }

    private void Undo()
    {
        if (undoDrafts.TryPop(out var previous))
        {
            draft = previous;
            selectedPath = string.Empty;
        }
    }

    private void SelectNode(string path) => selectedPath = path;

    private bool CanReplaceSelectedWith(ExpressionNode replacement)
    {
        if (CurrentNode is not ExpressionNode root ||
            !FilterExpressionTreeEditor.TryReplace(root, selectedPath, replacement, out var updated)) return false;
        return FilterExpressionValidator.Validate(updated).Count == 0;
    }

    private void ReplaceSelected(ExpressionNode replacement)
    {
        if (CurrentNode is not ExpressionNode root ||
            !FilterExpressionTreeEditor.TryReplace(root, selectedPath, replacement, out var updated) ||
            FilterExpressionValidator.Validate(updated).Count > 0) return;
        SetDraftFromRoot(updated);
    }

    private void ChangeLiteralValue(ChangeEventArgs args)
    {
        if (SelectedNode is not LiteralExpression literal) return;
        var value = args.Value?.ToString() ?? string.Empty;
        if (literal.ValueType == ExpressionValueType.Number &&
            !decimal.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out _)) return;
        ReplaceSelected(new LiteralExpression { ValueType = literal.ValueType, Value = value });
    }

    private void SetFormat(string format) =>
        ReplaceSelected(new LiteralExpression { ValueType = ExpressionValueType.String, Value = format });

    private void AppendFormatPart(string part)
    {
        if (SelectedNode is not LiteralExpression { ValueType: ExpressionValueType.String } literal) return;
        SetFormat((literal.Value ?? string.Empty) + part);
    }

    private bool CanAddArgument(FunctionExpression function)
    {
        if (!FilterExpressionCatalog.TryGetFunction(function.Name, out var definition) ||
            function.Arguments.Count >= definition.MaximumArguments || CurrentNode is not ExpressionNode root) return false;
        return FilterExpressionTreeEditor.TryAppendArgument(root, selectedPath, DefaultAdditionalArgument(function), out var updated) &&
            FilterExpressionValidator.Validate(updated).Count == 0;
    }

    private void AddArgument()
    {
        if (SelectedNode is not FunctionExpression function || !CanAddArgument(function) || CurrentNode is not ExpressionNode root) return;
        var newIndex = function.Arguments.Count;
        if (!FilterExpressionTreeEditor.TryAppendArgument(root, selectedPath, DefaultAdditionalArgument(function), out var updated)) return;
        SetDraftFromRoot(updated);
        selectedPath = FilterExpressionTreeEditor.ChildPath(selectedPath, newIndex);
    }

    private bool CanRemoveSelected()
    {
        if (CurrentNode is not ExpressionNode root ||
            !FilterExpressionTreeEditor.TryGetParent(root, selectedPath, out var parent, out _) ||
            !FilterExpressionCatalog.TryGetFunction(parent.Name, out var definition) ||
            parent.Arguments.Count <= definition.MinimumArguments) return false;
        return FilterExpressionTreeEditor.TryRemoveArgument(root, selectedPath, out var updated) &&
            FilterExpressionValidator.Validate(updated).Count == 0;
    }

    private void RemoveSelected()
    {
        if (!CanRemoveSelected() || CurrentNode is not ExpressionNode root ||
            !FilterExpressionTreeEditor.TryRemoveArgument(root, selectedPath, out var updated)) return;
        selectedPath = ParentPath(selectedPath);
        SetDraftFromRoot(updated);
    }

    private bool CanMoveSelected(int offset)
    {
        if (CurrentNode is not ExpressionNode root) return false;
        return FilterExpressionTreeEditor.TryMoveArgument(root, selectedPath, offset, out var updated, out _) &&
            FilterExpressionValidator.Validate(updated).Count == 0;
    }

    private void MoveSelected(int offset)
    {
        if (CurrentNode is not ExpressionNode root ||
            !FilterExpressionTreeEditor.TryMoveArgument(root, selectedPath, offset, out var updated, out var newPath) ||
            FilterExpressionValidator.Validate(updated).Count > 0) return;
        SetDraftFromRoot(updated);
        selectedPath = newPath;
    }

    private void SetDraftFromRoot(ExpressionNode root) => SetDraft($"{{{{{FilterExpressionParser.Format(root)}}}}}");

    private static ExpressionNode DefaultAdditionalArgument(FunctionExpression function) =>
        function.Name.Equals("string", StringComparison.OrdinalIgnoreCase)
            ? TextLiteral()
            : function.Arguments.Count > 0 ? FilterExpressionTreeEditor.Clone(function.Arguments[^1]) : TextLiteral();

    private static LiteralExpression TextLiteral() => new() { ValueType = ExpressionValueType.String, Value = string.Empty };
    private static LiteralExpression NumberLiteral() => new() { ValueType = ExpressionValueType.Number, Value = "0" };
    private static LiteralExpression BooleanLiteral() => new() { ValueType = ExpressionValueType.Boolean, Value = "False" };
    private static FunctionExpression EmptyList() => new() { Name = "createArray", Arguments = [TextLiteral()] };

    private static string ParentPath(string path)
    {
        var separator = path.LastIndexOf('/');
        return separator < 0 ? string.Empty : path[..separator];
    }

    private static string SelectedNodeLabel(ExpressionNode node) => node switch
    {
        FieldExpression field when FilterExpressionCatalog.TryGetField(field.Name, out var definition) => definition.Label,
        FunctionExpression function when FilterExpressionCatalog.TryGetFunction(function.Name, out var definition) => definition.Label,
        LiteralExpression literal => $"{FilterExpressionCatalog.TypeLabel(literal.ValueType)} value",
        _ => "formula node"
    };

    private void BeginDragField(string name) { draggedKind = "field"; draggedValue = name; }
    private void BeginDragFunction(string name) { draggedKind = "function"; draggedValue = name; }

    private void DropOnCanvas()
    {
        if (draggedKind == "field" && draggedValue is string fieldName) SetField(fieldName);
        else if (draggedKind == "function" && draggedValue is string functionName && FilterExpressionCatalog.TryGetFunction(functionName, out var function)) ApplyFunction(function);
        draggedKind = draggedValue = null;
    }

    private string InnerExpression()
    {
        var inner = draft.Trim();
        if (inner.StartsWith("{{") && inner.EndsWith("}}") && inner.Length >= 4) return inner[2..^2].Trim();
        return string.IsNullOrWhiteSpace(inner) ? "title" : $"\"{Escape(inner)}\"";
    }

    private bool MatchesSearch(params string[] values) => string.IsNullOrWhiteSpace(catalogSearch) ||
        values.Any(value => value.Contains(catalogSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private void ChangePreviewAnime(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var id)) previewAnimeId = id;
    }

    private PreviewResult BuildPreview()
    {
        if (DraftError is string error) return new(false, error, null);
        if (CurrentNode is not ExpressionNode node || SelectedPreviewAnime is not Anime anime) return new(false, "No sample is available.", null);
        if (!FilterExpressionEvaluator.TryEvaluate(node, anime, ExpressionEvaluationContext.Create(), out var value))
            return new(false, "No result for this anime. Try another sample with populated fields.", CurrentType);
        return new(true, FormatValue(value), value.Type);
    }

    private string PreviewFieldValue(ExpressionFieldDefinition field)
    {
        if (SelectedPreviewAnime is not Anime anime) return "—";
        var value = FilterExpressionEvaluator.Evaluate(new FieldExpression { Name = field.Name }, anime, ExpressionEvaluationContext.Create());
        return FormatValue(value);
    }

    private static IEnumerable<string> FindFieldNames(ExpressionNode node) => node switch
    {
        FieldExpression field => [field.Name],
        FunctionExpression function => function.Arguments.SelectMany(FindFieldNames),
        _ => []
    };

    private static string FormatValue(ExpressionValue value) => value switch
    {
        { IsNull: true } => "No value",
        { Type: ExpressionValueType.Boolean, Value: bool boolean } => boolean ? "Yes" : "No",
        { Type: ExpressionValueType.Number, Value: decimal number } => number.ToString("0.##", CultureInfo.InvariantCulture),
        { Type: ExpressionValueType.DateTime, Value: DateTime date } => date.ToString("d MMM yyyy", CultureInfo.InvariantCulture),
        { Type: ExpressionValueType.StringCollection, Value: IEnumerable<string> values } => values.Any() ? string.Join(", ", values) : "Empty list",
        _ => value.Value?.ToString() ?? "No value"
    };

    private static string Escape(string value) => value.Replace("\\", "\\\\").Replace("\"", "\\\"");

    private sealed record PreviewResult(bool Success, string Text, ExpressionValueType? Type);
    private sealed record FormatChoice(string Label, string Value, string Description);
}
