@page "/anime-review"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AnimeOverseer.Server.Services
@using AnimeOverseer.Server.Models
@using Microsoft.AspNetCore.Components.Web
@inject AnimeReviewService ReviewService
@inject SyncJobService SyncJobService

<PageTitle>Review catalogue matches - AnimeOverseer</PageTitle>

<div class="review-page">
    <div class="review-heading"><div><h1>Review catalogue matches</h1><p>Only title or alias matches are held here. Provider-ID matches continue automatically. Sorted by match score, most confident first.</p></div><div class="review-heading-actions"><button class="review-check-ids" @onclick="QueueProviderIdCheckAsync" disabled="@_queueingCheck" title="Fill missing AniList/MAL IDs from AniList, then resolve reviews whose IDs now match or rule out every candidate">Check provider IDs</button><a href="/settings" class="review-back">← Settings</a></div></div>
    <details class="review-automation" open="@(_settings?.Mode == AutoDecisionMode.Apply)">
        <summary>Automatic decisions: <strong>@ModeLabel(_settings?.Mode)</strong></summary>
        <p>Create as new when every candidate has a hard conflict (provider IDs, a franchise relation, movie vs series, or start dates a year apart). Merge when exactly one candidate is conflict-free and scores at least the threshold.</p>
        <div class="review-automation-form">
            <label>Mode <select @bind="_editMode"><option value="@AutoDecisionMode.Off">Off</option><option value="@AutoDecisionMode.Suggest">Suggest only (dry run)</option><option value="@AutoDecisionMode.Apply">Apply automatically</option></select></label>
            <label>Merge threshold <input type="number" min="@MatchingSettings.MinimumMergeThreshold" max="100" @bind="_editThreshold" /></label>
            <button @onclick="SaveSettingsAsync">Save</button>
            @if (!string.IsNullOrEmpty(_settingsNotice)) { <span>@_settingsNotice</span> }
        </div>
        <p class="review-muted">Applied after each import and each provider ID check. Existing suggestions apply the next time you run Check provider IDs.</p>
    </details>
    <div class="review-tabs" role="tablist">
        <button role="tab" class="@(_tab == "pending" ? "active" : "")" aria-selected="@(_tab == "pending")" @onclick='() => _tab = "pending"'>Needs review (@(_items?.Count ?? 0))</button>
        <button role="tab" class="@(_tab == "auto" ? "active" : "")" aria-selected="@(_tab == "auto")" @onclick="ShowAutoResolvedAsync">Auto-resolved (@_autoResolvedCount)</button>
    </div>
    @if (_checkJobId is int checkJobId) { <p class="review-notice">Provider ID check queued — <a href="/jobs/@checkJobId">follow job #@checkJobId</a>. Reload this page when it finishes.</p> } else if (!string.IsNullOrEmpty(_checkNotice)) { <p class="review-notice">@_checkNotice</p> }
    @if (_tab == "auto")
    {
        @if (!string.IsNullOrEmpty(_undoNotice)) { <p class="review-notice">@_undoNotice</p> }
        @if (_autoResolved is null) { <p class="review-muted">Loading automatic decisions…</p> }
        else if (_autoResolved.Count == 0) { <div class="review-empty"><h3>No automatic decisions yet</h3><p>Reviews resolved by provider IDs or decision bands are listed here, newest first, so you can undo them.</p></div> }
        else
        {
            <div class="review-list">
                @foreach (var item in _autoResolved)
                {
                    <div class="review-card review-card-static">
                        <span class="review-decision review-decision-@item.Review.Status.ToLowerInvariant()">@(item.Review.Status == "Merged" ? "Merged" : "Created")</span>
                        <div class="review-incoming review-media"><div><span class="review-label">Incoming</span><h3>@item.Incoming.Title</h3><p>@FormatDate(item.Incoming.StartDate) · @SourceLinks(item.Incoming.MALId, item.Incoming.AniListId)</p></div></div>
                        <div class="review-arrow">→</div>
                        <div class="review-candidate review-media"><div><span class="review-label">@(item.Review.Status == "Merged" ? "Merged into" : "Created as")</span>@if (item.Resolved is { } resolved) { <h3><a href="/anime/@resolved.Id">@resolved.Title</a></h3><p>@FormatDate(resolved.StartDate) · @SourceLinks(resolved.MALId, resolved.AniListId)</p> } else { <p>The catalogue record no longer exists.</p> }<p>@item.Review.ResolvedAt?.ToLocalTime().ToString("d MMM yyyy HH:mm")</p></div></div>
                        <div class="review-reason review-reason-actions"><span>@item.Review.Reason</span><button @onclick="() => UndoAsync(item.Review.Id)" disabled="@_working" title="@(item.Review.Status == "Merged" ? "Restore the record as it was before the merge" : "Delete the created record") and return this to Needs review">Undo</button></div>
                    </div>
                }
            </div>
        }
    }
    else if (_items is null) { <p class="review-muted">Loading review queue…</p> }
    else if (_items.Count == 0) { <div class="review-empty"><h3>Nothing needs review</h3><p>Future uncertain title matches will appear here instead of changing catalogue records.</p></div> }
    else
    {
        <div class="review-toolbar"><input class="review-select-all" type="checkbox" checked="@AllSelected" @onchange="ToggleAll" aria-label="Select all review records" /><strong>@_selected.Count selected</strong><span>Click to select · Shift-click selects a range · Ctrl/Cmd-click adds or removes records.</span><div class="review-toolbar-actions"><button @onclick='() => ResolveSelectedAsync("Create")' disabled="@(_selected.Count == 0 || _working)">Create as new</button><button @onclick='() => ResolveSelectedAsync("Merge")' disabled="@(!CanMergeSelection || _working)">Merge into shown match</button><button @onclick='() => ResolveSelectedAsync("Defer")' disabled="@(_selected.Count == 0 || _working)">Defer</button><button class="review-plain" @onclick="ClearSelection" disabled="@(_selected.Count == 0)">Clear</button></div></div>
        @if (!string.IsNullOrEmpty(_notice)) { <p class="review-notice">@_notice</p> }
        <div class="review-list">
            @foreach (var item in _items)
            {
                var selected = _selected.Contains(item.Review.Id);
                <div class="review-card @(selected ? "selected" : "")" @onclick="args => SelectItem(item.Review.Id, args)">
                    <input class="review-select" type="checkbox" checked="@selected" aria-label="Select @item.Incoming.Title" @onclick="args => ToggleCheckbox(item.Review.Id, args)" @onclick:stopPropagation />
                    <div class="review-incoming review-media">
                        @if (!string.IsNullOrWhiteSpace(item.Incoming.ImageUrl)) { <img class="review-poster" src="@item.Incoming.ImageUrl" alt="@item.Incoming.Title poster" /> } else { <div class="review-poster review-poster-empty">🎬</div> }
                        <div><span class="review-label">Incoming</span><h3>@item.Incoming.Title</h3><p>@FormatDate(item.Incoming.StartDate) · @SourceLinks(item.Incoming.MALId, item.Incoming.AniListId)</p></div>
                    </div>
                    <div class="review-arrow">→</div>
                    <div class="review-candidate review-media"><span class="review-label">@CandidateLabel(item)</span>@if (item.Candidates.Count == 1) { var candidate = item.Candidates[0]; <a href="/anime/@candidate.Id" class="review-poster-link" title="Open @candidate.Title" @onclick:stopPropagation>@if (!string.IsNullOrWhiteSpace(candidate.DisplayImageUrl)) { <img class="review-poster" src="@(candidate.DisplayLocalImagePath ?? candidate.DisplayImageUrl)" alt="@candidate.Title poster" /> } else { <div class="review-poster review-poster-empty">🎬</div> }</a><div><h3><a href="/anime/@candidate.Id" @onclick:stopPropagation>@candidate.Title</a></h3><p>@FormatDate(candidate.StartDate) · @candidate.Season.Year @candidate.Season.Name · @SourceLinks(candidate.MALId, candidate.AniListId)</p><a class="review-record-link" href="/anime/@candidate.Id" @onclick:stopPropagation>Open current record →</a></div> } else if (item.Candidates.Count > 1) { <p>@item.Candidates.Count possible matches — choose Create as new, or review individually after narrowing the catalogue.</p><ol class="review-candidate-ranking">@foreach (var candidate in item.Candidates) { var match = item.Matches.GetValueOrDefault(candidate.Id); <li><a href="/anime/@candidate.Id" @onclick:stopPropagation>@candidate.Title</a> <span>@FormatDate(candidate.StartDate)</span>@if (match is not null) { <span class="review-score review-score-@MatchScorer.Confidence(match).ToLowerInvariant()">@match.Score</span> }</li> }</ol> } else { <p>The prior candidate no longer exists. Create this record as new.</p> }</div>
                    @if (item.BestMatch is { } best)
                    {
                        var confidence = MatchScorer.Confidence(best);
                        <div class="review-evidence">
                            <span class="review-score review-score-@confidence.ToLowerInvariant()" title="Match score for the @(item.Candidates.Count > 1 ? "top-ranked" : "shown") candidate">@confidence · @best.Score</span>
                            @if (item.Suggestion is { } suggestion) { <span class="review-suggestion" title="@suggestion.Explanation">@(_settings?.Mode == AutoDecisionMode.Apply ? "Will" : "Would") @(suggestion.Decision == "Merge" ? "auto-merge" : "auto-create")</span> }
                            @foreach (var evidence in best.Evidence.Where(evidence => evidence.Kind != MatchEvidenceKind.Neutral))
                            {
                                <span class="review-evidence-item review-evidence-@evidence.Kind.ToString().ToLowerInvariant()">@EvidenceSign(evidence) @evidence.Detail</span>
                            }
                        </div>
                    }
                    <div class="review-reason">@item.Review.Reason</div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<PendingAnimeReviewItem>? _items;
    private readonly HashSet<int> _selected = [];
    private int? _anchorId;
    private bool _working;
    private string? _notice;
    private bool _queueingCheck;
    private int? _checkJobId;
    private string? _checkNotice;
    private string _tab = "pending";
    private List<AutoResolvedReviewItem>? _autoResolved;
    private int _autoResolvedCount;
    private string? _undoNotice;
    private MatchingSettings? _settings;
    private AutoDecisionMode _editMode;
    private int _editThreshold;
    private string? _settingsNotice;
    private async Task SaveSettingsAsync()
    {
        await ReviewService.SaveMatchingSettingsAsync(new MatchingSettings(_editMode, _editThreshold));
        await LoadSettingsAsync();
        _settingsNotice = "Saved.";
        await ReloadAsync();
    }
    private async Task LoadSettingsAsync()
    {
        _settings = await ReviewService.GetMatchingSettingsAsync();
        _editMode = _settings.Mode;
        _editThreshold = _settings.MergeThreshold;
    }
    private async Task ShowAutoResolvedAsync()
    {
        _tab = "auto";
        _autoResolved = await ReviewService.GetAutoResolvedAsync();
    }
    private async Task UndoAsync(int reviewId)
    {
        _working = true;
        var failure = await ReviewService.UndoAutomaticResolutionAsync(reviewId);
        _undoNotice = failure ?? "Undone. The review is back in Needs review and automation will leave it to you.";
        _autoResolved = await ReviewService.GetAutoResolvedAsync();
        await ReloadAsync();
        _working = false;
    }
    private static string ModeLabel(AutoDecisionMode? mode) => mode switch { AutoDecisionMode.Off => "off", AutoDecisionMode.Apply => "applied automatically", AutoDecisionMode.Suggest => "suggest only (dry run)", _ => "…" };
    private async Task QueueProviderIdCheckAsync()
    {
        _queueingCheck = true;
        var job = await SyncJobService.QueueAsync("ProviderIds");
        _checkJobId = job?.Id;
        _checkNotice = job is null ? "A provider ID check is already queued or running." : null;
        _queueingCheck = false;
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
        await ReloadAsync();
    }
    private bool CanMergeSelection => _selected.Count > 0 && _items is not null && _items.Where(item => _selected.Contains(item.Review.Id)).All(item => item.Candidates.Count == 1);
    private bool AllSelected => _items is { Count: > 0 } && _items.All(item => _selected.Contains(item.Review.Id));
    private void SelectItem(int id, MouseEventArgs args)
    {
        if (_items is null) return;
        if (args.ShiftKey && _anchorId is int anchor)
        {
            var start = _items.FindIndex(item => item.Review.Id == anchor); var end = _items.FindIndex(item => item.Review.Id == id);
            if (start >= 0 && end >= 0) { if (!args.CtrlKey && !args.MetaKey) _selected.Clear(); foreach (var item in _items.Skip(Math.Min(start, end)).Take(Math.Abs(end - start) + 1)) _selected.Add(item.Review.Id); return; }
        }
        if (args.CtrlKey || args.MetaKey) { if (!_selected.Add(id)) _selected.Remove(id); } else { _selected.Clear(); _selected.Add(id); }
        _anchorId = id;
    }
    private void ClearSelection() { _selected.Clear(); _anchorId = null; }
    private void ToggleAll(ChangeEventArgs args)
    {
        if (_items is null) return;
        var select = args.Value is bool value && value;
        _selected.Clear();
        if (select) foreach (var item in _items) _selected.Add(item.Review.Id);
        _anchorId = null;
    }
    private void ToggleCheckbox(int id, MouseEventArgs args)
    {
        if (!_selected.Add(id)) _selected.Remove(id);
        _anchorId = id;
    }
    private async Task ResolveSelectedAsync(string decision)
    {
        if (_items is null || _selected.Count == 0) return;
        _working = true; var selectedItems = _items.Where(item => _selected.Contains(item.Review.Id)).ToList(); var count = await ReviewService.ResolveAsync(selectedItems, decision);
        _notice = $"{count} record{(count == 1 ? "" : "s")} {decision.ToLowerInvariant()}d."; ClearSelection(); await ReloadAsync(); _working = false;
    }
    private async Task ReloadAsync()
    {
        _items = await ReviewService.GetPendingAsync();
        _autoResolvedCount = await ReviewService.GetAutoResolvedCountAsync();
    }
    private static string FormatDate(DateTime? value) => value?.ToString("MMM yyyy") ?? "Unknown date";
    private static RenderFragment SourceLinks(int? malId, int? aniListId) => builder =>
    {
        var sequence = 0;
        if (malId is > 0) { builder.OpenElement(sequence++, "a"); builder.AddAttribute(sequence++, "href", $"https://myanimelist.net/anime/{malId}"); builder.AddAttribute(sequence++, "target", "_blank"); builder.AddContent(sequence++, $"MAL {malId}"); builder.CloseElement(); }
        if (malId is > 0 && aniListId is > 0) builder.AddContent(sequence++, " · ");
        if (aniListId is > 0) { builder.OpenElement(sequence++, "a"); builder.AddAttribute(sequence++, "href", $"https://anilist.co/anime/{aniListId}"); builder.AddAttribute(sequence++, "target", "_blank"); builder.AddContent(sequence++, $"AniList {aniListId}"); builder.CloseElement(); }
        if (malId is not > 0 && aniListId is not > 0) builder.AddContent(sequence++, "No provider ID");
    };
    private static string EvidenceSign(MatchEvidence evidence) => evidence.Kind switch { MatchEvidenceKind.Positive => "+", MatchEvidenceKind.HardNegative => "✕", _ => "−" };
    private static string CandidateLabel(PendingAnimeReviewItem item) => item.Candidates.Count switch { 0 => "No current candidate", 1 => "Possible match", _ => "Possible matches" };
}
