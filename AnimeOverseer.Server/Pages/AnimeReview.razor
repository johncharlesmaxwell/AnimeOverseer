@page "/anime-review"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AnimeOverseer.Server.Services
@using AnimeOverseer.Server.Models
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@inject AnimeReviewService ReviewService
@inject SyncJobService SyncJobService
@inject SettingsService SettingsService
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Review catalogue matches - AnimeOverseer</PageTitle>

<div class="review-page">
    <div class="review-heading"><div><h1>Review catalogue matches</h1><p>Only title or alias matches are held here. Provider-ID matches continue automatically.</p></div><div class="review-heading-actions"><button class="review-check-ids" @onclick="QueueProviderIdCheckAsync" disabled="@_queueingCheck" title="Fill missing AniList/MAL IDs from AniList, then resolve reviews whose IDs now match or rule out every candidate">Check provider IDs</button><a href="/settings" class="review-back">← Settings</a></div></div>
    <p class="review-automation-summary">Automatic decisions: <strong>@ModeLabel(_settings?.Mode)</strong>@if (_settings is { Mode: not AutoDecisionMode.Off }) { <span> · merge threshold @_settings.MergeThreshold</span> } · <a href="/settings?tab=matching">Change in Matching settings</a></p>
    <div class="review-tabs" role="tablist">
        <button role="tab" class="@(_tab == "pending" ? "active" : "")" aria-selected="@(_tab == "pending")" @onclick='() => ShowView("pending")'>Needs review (@(_items?.Count ?? 0))</button>
        <button role="tab" class="@(_tab == "auto" ? "active" : "")" aria-selected="@(_tab == "auto")" @onclick='() => ShowView("auto")'>Auto-resolved (@_autoResolvedCount)</button>
        <button role="tab" class="@(_tab == "deferred" ? "active" : "")" aria-selected="@(_tab == "deferred")" @onclick='() => ShowView("deferred")'>Deferred (@_deferredCount)</button>
        <button role="tab" class="@(_tab == "remembered" ? "active" : "")" aria-selected="@(_tab == "remembered")" @onclick='() => ShowView("remembered")'>Remembered (@_rememberedCount)</button>
    </div>
    @if (_checkJobId is int checkJobId) { <p class="review-notice">Provider ID check queued — <a href="/jobs/@checkJobId">follow job #@checkJobId</a>. Reload this page when it finishes.</p> } else if (!string.IsNullOrEmpty(_checkNotice)) { <p class="review-notice">@_checkNotice</p> }
    @if (_tab == "deferred")
    {
        @if (_deferred is null) { <p class="review-muted">Loading deferred reviews…</p> }
        else if (_deferred.Count == 0) { <div class="review-empty"><h3>Nothing is deferred</h3><p>Deferred reviews wait here until their snooze ends; the next import of that anime after that reopens them.</p></div> }
        else
        {
            <ReviewFilterBar Label="Filter deferred reviews" Filters="DeferredFilters" Sorts="DeferredSorts" Shown="_visibleDeferred.Count" Total="_deferred.Count" />
            @if (_visibleDeferred.Count == 0) { <p class="review-muted">No deferred reviews match these filters.</p> }
            <ReviewPager Total="_visibleDeferred.Count" Page="_page" PageSize="_pageSize" PageChanged="GoToPage" PageSizeChanged="SetPageSize" Label="Deferred review pages" />
            <div class="review-list">
                @foreach (var item in ReviewPager.Slice(_visibleDeferred, _page, _pageSize))
                {
                    <div class="review-row">
                        <div><h3>@item.Incoming.Title</h3><p>@FormatDate(item.Incoming.StartDate) · @SourceLinks(item.Incoming.MALId, item.Incoming.AniListId)</p></div>
                        <span class="review-muted">@(item.Review.DeferredUntil is { } until ? (until > DateTime.UtcNow ? $"Snoozed until {until.ToLocalTime():d MMM yyyy}" : "Reopens on its next import") : "Reopens on its next import")</span>
                        <button @onclick="() => ReopenAsync(item.Review.Id)" disabled="@_working">Review now</button>
                    </div>
                }
            </div>
        }
    }
    else if (_tab == "remembered")
    {
        <p class="review-muted">Answers you gave when merging or creating, or by undoing an automatic merge. Imports follow them instead of asking again. Forget one to let title matching consider that pair again.</p>
        @if (_rememberedPage is null) { <p class="review-muted">Loading remembered decisions…</p> }
        else if (_rememberedCount == 0) { <div class="review-empty"><h3>Nothing remembered yet</h3><p>Merge or create a review and the answer is kept here.</p></div> }
        else
        {
            <ReviewFilterBar Label="Filter remembered decisions" FilterLabel="Answer" Filters="RememberedFilters" SecondFilterLabel="From" SecondFilters="RememberedOriginFilters" Sorts="RememberedSorts" Shown="_rememberedPage.Matching" Total="_rememberedCount" />
            @if (_rememberedPage.Matching == 0) { <p class="review-muted">No remembered decisions match these filters.</p> }
            <ReviewPager Total="_rememberedPage.Matching" Page="_page" PageSize="_pageSize" PageChanged="GoToPage" PageSizeChanged="SetPageSize" Label="Remembered decision pages" />
            <div class="review-list">
                @foreach (var item in _rememberedPage.Items)
                {
                    <div class="review-row">
                        <div><h3>@(item.SourceTitle ?? "Provider record") <span class="review-decision-inline review-decision-inline-@(item.Decision.IsSameAnime ? "same" : "different")">@(item.Decision.IsSameAnime ? "is" : "is not")</span> <a href="/anime/@item.Decision.AnimeId">@item.AnimeTitle</a></h3><p>@SourceLinks(item.Decision.SourceMalId, item.Decision.SourceAniListId) · from @item.Decision.Origin.ToLowerInvariant() · @item.Decision.DecidedAt.ToLocalTime().ToString("d MMM yyyy")</p></div>
                        <button @onclick="() => ForgetAsync(item.Decision.Id)" disabled="@_working">Forget</button>
                    </div>
                }
            </div>
        }
    }
    else if (_tab == "auto")
    {
        @if (!string.IsNullOrEmpty(_undoNotice)) { <p class="review-notice">@_undoNotice</p> }
        @if (_autoPage is null) { <p class="review-muted">Loading automatic decisions…</p> }
        else if (_autoResolvedCount == 0) { <div class="review-empty"><h3>No automatic decisions yet</h3><p>Reviews resolved by provider IDs or decision bands are listed here, newest first, so you can undo them.</p></div> }
        else
        {
            <ReviewFilterBar Label="Filter automatic decisions" FilterLabel="Decision" Filters="AutoFilters" Sorts="AutoSorts" Shown="_autoPage.Matching" Total="_autoResolvedCount" />
            @if (_autoPage.Matching == 0) { <p class="review-muted">No automatic decisions match these filters.</p> }
            <ReviewPager Total="_autoPage.Matching" Page="_page" PageSize="_pageSize" PageChanged="GoToPage" PageSizeChanged="SetPageSize" Label="Automatic decision pages" />
            <div class="review-list">
                @foreach (var item in _autoPage.Items)
                {
                    <div class="review-card review-card-static">
                        <span class="review-decision review-decision-@item.Review.Status.ToLowerInvariant()">@(item.Review.Status == "Merged" ? "Merged" : "Created")</span>
                        <div class="review-incoming review-media"><div><span class="review-label">Incoming</span><h3>@item.Incoming.Title</h3><p>@FormatDate(item.Incoming.StartDate) · @SourceLinks(item.Incoming.MALId, item.Incoming.AniListId)</p></div></div>
                        <div class="review-arrow">→</div>
                        <div class="review-candidate review-media"><div><span class="review-label">@(item.Review.Status == "Merged" ? "Merged into" : "Created as")</span>@if (item.Resolved is { } resolved) { <h3><a href="/anime/@resolved.Id">@resolved.Title</a></h3><p>@FormatDate(resolved.StartDate) · @SourceLinks(resolved.MALId, resolved.AniListId)</p> } else { <p>The catalogue record no longer exists.</p> }<p>@item.Review.ResolvedAt?.ToLocalTime().ToString("d MMM yyyy HH:mm")</p></div></div>
                        <div class="review-reason review-reason-actions"><span>@item.Review.Reason</span><button @onclick="() => UndoAsync(item.Review.Id)" disabled="@_working" title="@(item.Review.Status == "Merged" ? "Restore the record as it was before the merge" : "Delete the created record") and return this to Needs review">Undo</button></div>
                    </div>
                }
            </div>
        }
    }
    else if (_items is null) { <p class="review-muted">Loading review queue…</p> }
    else if (_items.Count == 0) { <div class="review-empty"><h3>Nothing needs review</h3><p>Future uncertain title matches will appear here instead of changing catalogue records.</p></div> }
    else
    {
        <ReviewFilterBar Label="Filter the review queue" SearchPlaceholder="Search incoming and candidate titles" FilterLabel="Confidence" Filters="ConfidenceFilters" SecondFilterLabel="Automation" SecondFilters="@(_settings is { Mode: not AutoDecisionMode.Off } ? AutomationFilters : null)" Sorts="PendingSorts" Shown="_visibleItems.Count" Total="_items.Count" />
        <div class="review-toolbar"><input class="review-select-all" type="checkbox" checked="@AllSelected" @onchange="ToggleAll" aria-label="Select all review records on this page" /><strong>@_selected.Count selected</strong><span>Click to select · Shift-click selects a range · Ctrl/Cmd-click adds or removes records.</span><div class="review-toolbar-actions"><button @onclick='() => ResolveSelectedAsync("Create")' disabled="@(_selected.Count == 0 || _working)">Create as new</button><button @onclick='() => ResolveSelectedAsync("Merge")' disabled="@(!CanMergeSelection || _working)">Merge into shown match</button><button @onclick='() => ResolveSelectedAsync("Defer")' disabled="@(_selected.Count == 0 || _working)">Defer</button><button class="review-plain" @onclick="ClearSelection" disabled="@(_selected.Count == 0)">Clear</button></div></div>
        @if (!string.IsNullOrEmpty(_notice)) { <p class="review-notice">@_notice</p> }
        @if (_visibleItems.Count == 0) { <p class="review-muted">No reviews match these filters.</p> }
        <ReviewPager Total="_visibleItems.Count" Page="_page" PageSize="_pageSize" PageChanged="GoToPage" PageSizeChanged="SetPageSize" Label="Review queue pages" />
        <div class="review-list">
            @foreach (var item in PageItems)
            {
                var selected = _selected.Contains(item.Review.Id);
                <div class="review-card @(selected ? "selected" : "")" @onclick="args => SelectItem(item.Review.Id, args)">
                    <input class="review-select" type="checkbox" checked="@selected" aria-label="Select @item.Incoming.Title" @onclick="args => ToggleCheckbox(item.Review.Id, args)" @onclick:stopPropagation />
                    <div class="review-incoming review-media">
                        @if (!string.IsNullOrWhiteSpace(item.Incoming.ImageUrl)) { <img class="review-poster" src="@item.Incoming.ImageUrl" alt="@item.Incoming.Title poster" /> } else { <div class="review-poster review-poster-empty">🎬</div> }
                        <div><span class="review-label">Incoming</span><h3>@item.Incoming.Title</h3><p>@FormatDate(item.Incoming.StartDate) · @SourceLinks(item.Incoming.MALId, item.Incoming.AniListId)</p></div>
                    </div>
                    <div class="review-arrow">→</div>
                    <div class="review-candidate review-media"><span class="review-label">@CandidateLabel(item)</span>@if (item.Candidates.Count == 1) { var candidate = item.Candidates[0]; <a href="/anime/@candidate.Id" class="review-poster-link" title="Open @candidate.Title" @onclick:stopPropagation>@if (!string.IsNullOrWhiteSpace(candidate.DisplayImageUrl)) { <img class="review-poster" src="@(candidate.DisplayLocalImagePath ?? candidate.DisplayImageUrl)" alt="@candidate.Title poster" /> } else { <div class="review-poster review-poster-empty">🎬</div> }</a><div><h3><a href="/anime/@candidate.Id" @onclick:stopPropagation>@candidate.Title</a></h3><p>@FormatDate(candidate.StartDate) · @candidate.Season.Year @candidate.Season.Name · @SourceLinks(candidate.MALId, candidate.AniListId)</p><a class="review-record-link" href="/anime/@candidate.Id" @onclick:stopPropagation>Open current record →</a></div> } else if (item.Candidates.Count > 1) { <p>@item.Candidates.Count possible matches — choose Create as new, or review individually after narrowing the catalogue.</p><ol class="review-candidate-ranking">@foreach (var candidate in item.Candidates) { var match = item.Matches.GetValueOrDefault(candidate.Id); <li><a href="/anime/@candidate.Id" @onclick:stopPropagation>@candidate.Title</a> <span>@FormatDate(candidate.StartDate)</span>@if (match is not null) { <span class="review-score review-score-@MatchScorer.Confidence(match, _settings?.Scoring).ToLowerInvariant()">@match.Score</span> }</li> }</ol> } else { <p>The prior candidate no longer exists. Create this record as new.</p> }</div>
                    @if (item.BestMatch is { } best)
                    {
                        var confidence = MatchScorer.Confidence(best, _settings?.Scoring);
                        <div class="review-evidence">
                            <span class="review-score review-score-@confidence.ToLowerInvariant()" title="Match score for the @(item.Candidates.Count > 1 ? "top-ranked" : "shown") candidate">@confidence · @best.Score</span>
                            @if (item.Suggestion is { } suggestion) { <span class="review-suggestion" title="@suggestion.Explanation">@(_settings?.Mode == AutoDecisionMode.Apply ? "Will" : "Would") @(suggestion.Decision == "Merge" ? "auto-merge" : "auto-create")</span> }
                            else if (item.Undecided is { } undecided) { <span class="review-undecided">@undecided</span> }
                            @foreach (var evidence in best.Evidence.Where(evidence => evidence.Kind != MatchEvidenceKind.Neutral))
                            {
                                <span class="review-evidence-item review-evidence-@evidence.Kind.ToString().ToLowerInvariant()">@EvidenceSign(evidence) @evidence.Detail</span>
                            }
                        </div>
                    }
                    <div class="review-reason">@item.Review.Reason</div>
                </div>
            }
        </div>
        <ReviewPager Total="_visibleItems.Count" Page="_page" PageSize="_pageSize" PageChanged="GoToPage" PageSizeChanged="SetPageSize" Label="Review queue pages" />
    }
</div>

@code {
    private List<PendingAnimeReviewItem>? _items;
    private readonly HashSet<int> _selected = [];
    private int? _anchorId;
    private bool _working;
    private string? _notice;
    private bool _queueingCheck;
    private int? _checkJobId;
    private string? _checkNotice;
    private string _tab = "pending";
    // Auto-resolved and Remembered can grow without limit, so they are searched and paged in SQL one page at a time.
    private ReviewListPage<AutoResolvedReviewItem>? _autoPage;
    private int _autoResolvedCount;
    private string? _undoNotice;
    private MatchingSettings? _settings;
    private List<DeferredReviewItem>? _deferred;
    private int _deferredCount;
    private ReviewListPage<RememberedDecisionItem>? _rememberedPage;
    private int _rememberedCount;
    // The view and page live in the query string (?view=deferred&page=2) so browser back/forward walks through them.
    // Read from NavigationManager rather than [SupplyParameterFromQuery]: this component is nested in /settings, and
    // nested query subscribers can crash Blazor's location-change dispatch when the parent re-renders mid-notification.
    private static readonly string[] Views = ["pending", "auto", "deferred", "remembered"];
    private async Task ApplyLocationAsync()
    {
        var requested = ReviewPager.QueryValue(Nav, "view")?.ToLowerInvariant();
        var view = requested is not null && Views.Contains(requested) ? requested : "pending";
        if (view != _tab) { _tab = view; await LoadViewAsync(view); }
        var filters = (ReviewPager.QueryValue(Nav, "search"), ReviewPager.QueryValue(Nav, "show"), ReviewPager.QueryValue(Nav, "show2"), ReviewPager.QueryValue(Nav, "sort"));
        if (filters != (_query, _show, _show2, _sort)) ClearSelection();
        (_query, _show, _show2, _sort) = filters;
        ApplyFilters();
        var requestedPage = ReviewPager.QueryPage(Nav);
        var page = IsPagedTab ? await LoadPagedAsync(requestedPage) : ReviewPager.Clamp(requestedPage, CurrentTabCount, _pageSize);
        if (page != _page) ClearSelection();
        _page = page;
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(async () => { await ApplyLocationAsync(); StateHasChanged(); });
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
    private async Task LoadViewAsync(string view)
    {
        switch (view)
        {
            case "deferred": _deferred = await ReviewService.GetDeferredAsync(); break;
        }
        ApplyFilters();
    }
    private bool IsPagedTab => _tab is "auto" or "remembered";
    /// <summary>Loads the requested page of the current SQL-paged tab and returns the page actually shown.</summary>
    private async Task<int> LoadPagedAsync(int page)
    {
        var request = new ReviewListQuery(_query, _show, _show2, _sort, page, _pageSize);
        if (_tab == "auto") { _autoPage = await ReviewService.GetAutoResolvedPageAsync(request); return _autoPage.Page; }
        if (_tab == "remembered") { _rememberedPage = await ReviewService.GetRememberedDecisionsPageAsync(request); return _rememberedPage.Page; }
        return page;
    }
    // Each tab has its own filters, so switching tabs starts from an unfiltered list.
    private void ShowView(string view) => Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = view == "pending" ? null : view, ["page"] = null, ["search"] = null, ["show"] = null, ["show2"] = null, ["sort"] = null }));
    private void NavigateToPage(int page, bool replace = false) => Nav.NavigateTo(Nav.GetUriWithQueryParameter("page", page <= 1 ? (int?)null : page), replace: replace);
    private async Task ReopenAsync(int reviewId)
    {
        _working = true;
        await ReviewService.ReopenDeferredAsync(reviewId);
        _deferred = await ReviewService.GetDeferredAsync();
        await ReloadAsync();
        _working = false;
    }
    private async Task ForgetAsync(int decisionId)
    {
        _working = true;
        await ReviewService.ForgetDecisionAsync(decisionId);
        await ReloadAsync();
        _working = false;
    }
    private async Task LoadSettingsAsync()
    {
        _settings = await ReviewService.GetMatchingSettingsAsync();
        _pageSize = ReviewPagingSettings.Read(await SettingsService.GetAsync(ReviewPagingSettings.MatchesKey));
    }
    private async Task UndoAsync(int reviewId)
    {
        _working = true;
        var failure = await ReviewService.UndoAutomaticResolutionAsync(reviewId);
        _undoNotice = failure ?? "Undone. The review is back in Needs review and automation will leave it to you.";
        await ReloadAsync();
        _working = false;
    }
    private static string ModeLabel(AutoDecisionMode? mode) => mode switch { AutoDecisionMode.Off => "off", AutoDecisionMode.Apply => "applied automatically", AutoDecisionMode.Suggest => "suggest only (dry run)", _ => "…" };
    private async Task QueueProviderIdCheckAsync()
    {
        _queueingCheck = true;
        var job = await SyncJobService.QueueAsync("ProviderIds");
        _checkJobId = job?.Id;
        _checkNotice = job is null ? "A provider ID check is already queued or running." : null;
        _queueingCheck = false;
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
        await ReloadAsync();
        await ApplyLocationAsync();
        Nav.LocationChanged += OnLocationChanged;
    }
    private bool CanMergeSelection => _selected.Count > 0 && _items is not null && _items.Where(item => _selected.Contains(item.Review.Id)).All(item => item.Candidates.Count == 1);
    private bool AllSelected => PageItems.Count > 0 && PageItems.All(item => _selected.Contains(item.Review.Id));
    private int _page = 1;
    private int _pageSize = ReviewPagingSettings.DefaultPageSize;
    private List<PendingAnimeReviewItem> PageItems => ReviewPager.Slice(_visibleItems, _page, _pageSize).ToList();
    private int CurrentTabCount => _tab switch { "deferred" => _visibleDeferred.Count, "remembered" => _rememberedPage?.Matching ?? 0, "auto" => _autoPage?.Matching ?? 0, _ => _visibleItems.Count };
    // Selection is per page, so an action never touches records the person cannot see.
    private void GoToPage(int page) => NavigateToPage(ReviewPager.Clamp(page, CurrentTabCount, _pageSize));
    private async Task SetPageSize(int size) { _pageSize = size; _page = 1; ClearSelection(); await SettingsService.SetAsync(ReviewPagingSettings.MatchesKey, size.ToString()); NavigateToPage(1, replace: true); }
    private void SelectItem(int id, MouseEventArgs args)
    {
        if (_items is null) return;
        if (args.ShiftKey && _anchorId is int anchor)
        {
            var visible = PageItems;
            var start = visible.FindIndex(item => item.Review.Id == anchor); var end = visible.FindIndex(item => item.Review.Id == id);
            if (start >= 0 && end >= 0) { if (!args.CtrlKey && !args.MetaKey) _selected.Clear(); foreach (var item in visible.Skip(Math.Min(start, end)).Take(Math.Abs(end - start) + 1)) _selected.Add(item.Review.Id); return; }
        }
        if (args.CtrlKey || args.MetaKey) { if (!_selected.Add(id)) _selected.Remove(id); } else { _selected.Clear(); _selected.Add(id); }
        _anchorId = id;
    }
    private void ClearSelection() { _selected.Clear(); _anchorId = null; }
    private void ToggleAll(ChangeEventArgs args)
    {
        if (_items is null) return;
        var select = args.Value is bool value && value;
        _selected.Clear();
        if (select) foreach (var item in PageItems) _selected.Add(item.Review.Id);
        _anchorId = null;
    }
    private void ToggleCheckbox(int id, MouseEventArgs args)
    {
        if (!_selected.Add(id)) _selected.Remove(id);
        _anchorId = id;
    }
    private async Task ResolveSelectedAsync(string decision)
    {
        if (_items is null || _selected.Count == 0) return;
        _working = true; var selectedItems = _items.Where(item => _selected.Contains(item.Review.Id)).ToList(); var count = await ReviewService.ResolveAsync(selectedItems, decision);
        _notice = $"{count} record{(count == 1 ? "" : "s")} {decision.ToLowerInvariant()}d."; ClearSelection(); await ReloadAsync(); _working = false;
    }
    private async Task ReloadAsync()
    {
        _items = await ReviewService.GetPendingAsync();
        ApplyFilters();
        _autoResolvedCount = await ReviewService.GetAutoResolvedCountAsync();
        _deferredCount = await ReviewService.GetDeferredCountAsync();
        _rememberedCount = await ReviewService.GetRememberedDecisionCountAsync();
        _page = IsPagedTab ? await LoadPagedAsync(_page) : ReviewPager.Clamp(_page, CurrentTabCount, _pageSize);
    }
    // Needs review and Deferred are filtered and ordered in memory (Needs review's scores are computed live);
    // the filter bar keeps every tab's choices in the query string.
    private string? _query, _show, _show2, _sort;
    private List<PendingAnimeReviewItem> _visibleItems = [];
    private List<DeferredReviewItem> _visibleDeferred = [];
    private static KeyValuePair<string, string> Option(string key, string label) => new(key, label);
    private static readonly KeyValuePair<string, string>[] ConfidenceFilters = [Option("high", "High"), Option("medium", "Medium"), Option("low", "Low"), Option("conflict", "Conflict"), Option("none", "No candidate")];
    private static readonly KeyValuePair<string, string>[] AutomationFilters = [Option("merge", "Would auto-merge"), Option("create", "Would auto-create"), Option("person", "Left for you"), Option("undone", "Automation undone")];
    private static readonly KeyValuePair<string, string>[] PendingSorts = [Option("score", "Best match first"), Option("score-asc", "Weakest match first"), Option("newest", "Newest queued"), Option("oldest", "Oldest queued"), Option("title", "Title A–Z"), Option("aired", "Aired, newest first"), Option("aired-asc", "Aired, oldest first")];
    private static readonly KeyValuePair<string, string>[] AutoFilters = [Option("merged", "Merged"), Option("created", "Created")];
    private static readonly KeyValuePair<string, string>[] AutoSorts = [Option("newest", "Newest first"), Option("oldest", "Oldest first"), Option("title", "Title A–Z")];
    private static readonly KeyValuePair<string, string>[] DeferredFilters = [Option("snoozed", "Still snoozed"), Option("ready", "Reopens on next import")];
    private static readonly KeyValuePair<string, string>[] DeferredSorts = [Option("soonest", "Reopens soonest"), Option("latest", "Reopens latest"), Option("title", "Title A–Z")];
    private static readonly KeyValuePair<string, string>[] RememberedFilters = [Option("same", "Same anime"), Option("different", "Different anime")];
    private static readonly KeyValuePair<string, string>[] RememberedOriginFilters = [Option("merge", "Merge"), Option("create", "Create"), Option("undo", "Undo")];
    private static readonly KeyValuePair<string, string>[] RememberedSorts = [Option("newest", "Newest first"), Option("oldest", "Oldest first"), Option("title", "Catalogue title A–Z")];

    private void ApplyFilters()
    {
        var titleOrder = StringComparer.CurrentCultureIgnoreCase;
        var pending = (_items ?? [])
            .Where(item => ReviewFilterBar.Matches(_query, [item.Incoming.Title, item.Incoming.OriginalTitle, .. item.Incoming.AlternativeTitles, .. item.Candidates.Select(candidate => candidate.Title), item.Review.Reason]))
            .Where(item => _show is null || ConfidenceOf(item) == _show)
            .Where(item => _show2 switch
            {
                "merge" => item.Suggestion?.Decision == "Merge",
                "create" => item.Suggestion?.Decision == "Create",
                "person" => item.Suggestion is null,
                "undone" => item.Review.AutoDecisionUndone,
                _ => true
            });
        _visibleItems = (_sort switch
        {
            "score-asc" => pending.OrderBy(item => item.BestMatch?.Score ?? -1).ThenBy(item => item.Review.CreatedAt),
            "newest" => pending.OrderByDescending(item => item.Review.CreatedAt),
            "oldest" => pending.OrderBy(item => item.Review.CreatedAt),
            "title" => pending.OrderBy(item => item.Incoming.Title, titleOrder),
            "aired" => pending.OrderByDescending(item => item.Incoming.StartDate ?? DateTime.MinValue),
            "aired-asc" => pending.OrderBy(item => item.Incoming.StartDate ?? DateTime.MaxValue),
            _ => pending // The service already returns best match first.
        }).ToList();

        var now = DateTime.UtcNow;
        var deferred = (_deferred ?? [])
            .Where(item => ReviewFilterBar.Matches(_query, item.Incoming.Title, item.Incoming.OriginalTitle, item.Review.Reason))
            .Where(item => _show switch { "snoozed" => item.Review.DeferredUntil > now, "ready" => !(item.Review.DeferredUntil > now), _ => true });
        _visibleDeferred = (_sort switch
        {
            "latest" => deferred.OrderByDescending(item => item.Review.DeferredUntil ?? DateTime.MinValue),
            "title" => deferred.OrderBy(item => item.Incoming.Title, titleOrder),
            _ => deferred.OrderBy(item => item.Review.DeferredUntil ?? DateTime.MinValue)
        }).ToList();
    }

    private string ConfidenceOf(PendingAnimeReviewItem item) => item.BestMatch is { } best ? MatchScorer.Confidence(best, _settings?.Scoring).ToLowerInvariant() : "none";
    private static string FormatDate(DateTime? value) => value?.ToString("MMM yyyy") ?? "Unknown date";
    private static RenderFragment SourceLinks(int? malId, int? aniListId) => builder =>
    {
        var sequence = 0;
        if (malId is > 0) { builder.OpenElement(sequence++, "a"); builder.AddAttribute(sequence++, "href", $"https://myanimelist.net/anime/{malId}"); builder.AddAttribute(sequence++, "target", "_blank"); builder.AddContent(sequence++, $"MAL {malId}"); builder.CloseElement(); }
        if (malId is > 0 && aniListId is > 0) builder.AddContent(sequence++, " · ");
        if (aniListId is > 0) { builder.OpenElement(sequence++, "a"); builder.AddAttribute(sequence++, "href", $"https://anilist.co/anime/{aniListId}"); builder.AddAttribute(sequence++, "target", "_blank"); builder.AddContent(sequence++, $"AniList {aniListId}"); builder.CloseElement(); }
        if (malId is not > 0 && aniListId is not > 0) builder.AddContent(sequence++, "No provider ID");
    };
    private static string EvidenceSign(MatchEvidence evidence) => evidence.Kind switch { MatchEvidenceKind.Positive => "+", MatchEvidenceKind.HardNegative => "✕", _ => "−" };
    private static string CandidateLabel(PendingAnimeReviewItem item) => item.Candidates.Count switch { 0 => "No current candidate", 1 => "Possible match", _ => "Possible matches" };
}
