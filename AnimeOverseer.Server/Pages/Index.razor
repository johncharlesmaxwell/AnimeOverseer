    private async Task SetCollectionFilterAsync(int collectionId)
    {
        activeCollectionId = collectionId;
        quickFilterPreset = null;
        searchQuery = string.Empty;
        filterState = new FilterState();
        sortState = new SortState();
        allAnimes = [];
        totalCount = 0;
        PushUrl(replace: true);
        await LoadCollectionFilter();
    }

    // ── Serialisation ────────────────────────────────────────

    private static string SerializeFilters(FilterState state)
    {
        var dto = new
        {
            l = (int)state.TopLevelLogic,
            g = state.Groups.Where(FilterState.IsActiveGroup).Select(SerializeGroup)
                .ToArray()
        };
        return JsonSerializer.Serialize(dto);
    }

    private static string SerializeSort(SortState state)
    {
        var dto = state.Criteria
            .Select(c => new { f = (int)c.Field, d = (int)c.Direction })
            .ToArray();
        return JsonSerializer.Serialize(dto);
    }

    private static SortState? DeserializeSort(string encoded)
    {
        try
        {
            using var doc = JsonDocument.Parse(encoded);
            return new SortState
            {
                Criteria = doc.RootElement.EnumerateArray().Select(c => new SortCriterion
                {
                    Field     = (SortField)c.GetProperty("f").GetInt32(),
                    Direction = (SortDirection)c.GetProperty("d").GetInt32()
                }).ToList()
            };
        }
        catch { return null; }
    }

    private static FilterState? DeserializeFilters(string encoded)
    {
        try
        {
            using var doc = JsonDocument.Parse(encoded);
            var root  = doc.RootElement;
            var state = new FilterState
            {
                TopLevelLogic = (GroupLogic)root.GetProperty("l").GetInt32(),
                Groups = root.GetProperty("g").EnumerateArray().Select(DeserializeGroup).ToList()
            };
            if (state.Groups.Count == 0) state.Groups.Add(new FilterGroup());
            return state;
        }
        catch { return null; }
    }

    private static bool IsQuickFilterPreset(string preset) => preset is
        "top-airing" or "top-upcoming" or "top-tv" or "top-movies" or
        "top-ovas" or "top-onas" or "top-specials" or "most-popular" or "most-favorited";

    private static object SerializeGroup(FilterGroup group) => new
    {
        l = (int)group.Logic,
        c = group.Conditions.Where(FilterState.IsActiveCondition)
            .Select(c => new { f = (int)c.Field, o = (int)c.Operator, v = c.Value, vs = c.Values, vl = (int)c.ValueLogic }).ToArray(),
        g = group.Subgroups.Where(FilterState.IsActiveGroup).Select(SerializeGroup).ToArray()
    };

    private static FilterGroup DeserializeGroup(JsonElement group) => new()
    {
        Logic = (GroupLogic)group.GetProperty("l").GetInt32(),
        Conditions = group.GetProperty("c").EnumerateArray().Select(c => new FilterCondition
        {
            Field = (FilterField)c.GetProperty("f").GetInt32(), Operator = (FilterOperator)c.GetProperty("o").GetInt32(),
            Value = c.GetProperty("v").GetString() ?? string.Empty,
            Values = c.TryGetProperty("vs", out var values) ? values.EnumerateArray().Select(value => value.GetString() ?? string.Empty).ToList() : [],
            ValueLogic = c.TryGetProperty("vl", out var valueLogic) ? (ValueLogic)valueLogic.GetInt32() : ValueLogic.Any
        }).ToList(),
        Subgroups = group.TryGetProperty("g", out var subgroups) ? subgroups.EnumerateArray().Select(DeserializeGroup).ToList() : []
    };
}
