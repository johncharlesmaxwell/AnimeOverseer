@page "/"
@rendermode InteractiveServer
@using AnimeOverseer.Server.Models
@using AnimeOverseer.Server.Services
@using System.Text.Json
@inject IAnimeDataSource AnimeDataSource
@inject NavigationManager NavManager
@inject MediaLibraryService MediaLibraryService
@inject SettingsService SettingsService
@inject CollectionService CollectionService
@inject CollectionDragService CollectionDragService
@implements IDisposable

<PageTitle>AnimeOverseer - Dashboard</PageTitle>

<div class="dashboard dashboard-full-width">
    <div class="controls-bar">
        <div class="preset-filters-row" aria-label="Quick filters">
            <button class="preset-filter" @onclick="SetPresetAllAnime">All Anime</button>
            <button class="preset-filter" @onclick="SetPresetTopAiring">Top Airing</button>
            <button class="preset-filter" @onclick="SetPresetTopUpcoming">Top Upcoming</button>
            <button class="preset-filter" @onclick="SetPresetTopTVSeries">Top TV Series</button>
            <button class="preset-filter" @onclick="SetPresetTopMovies">Top Movies</button>
            <button class="preset-filter" @onclick="SetPresetTopOVAs">Top OVAs</button>
            <button class="preset-filter" @onclick="SetPresetTopONAs">Top ONAs</button>
            <button class="preset-filter" @onclick="SetPresetTopSpecials">Top Specials</button>
            <button class="preset-filter" @onclick="SetPresetMostPopular">Most Popular</button>
            <button class="preset-filter" @onclick="SetPresetMostFavorited">Most Favorited</button>
            @foreach (var collection in homepageCollections)
            {
                <button class="preset-filter collection-preset-filter @(activeCollectionId == collection.Id ? "active" : "")"
                        aria-pressed="@(activeCollectionId == collection.Id)"
                        title="Show the @collection.Name collection"
                        @onclick="() => SetCollectionFilterAsync(collection.Id)">@collection.Name</button>
            }
        </div>

        <div class="filters-row">
            <label class="filter-label" for="pagesize-select">Load:</label>
            <select id="pagesize-select" value="@pageSize" @onchange="OnPageSizeChanged" class="form-select" style="width:auto">
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="500">500</option>
                <option value="1000">1000</option>
            </select>
            <span class="filter-label">at a time</span>
            <label class="quick-filter" title="Hide anime already present in Sonarr or Radarr">
                <input type="checkbox" checked="@hideInLibrary" @onchange="ToggleHideInLibrary" />
                Hide in library
            </label>
            <label class="quick-filter" title="Include anime marked with an NSFW genre or theme">
                <input type="checkbox" checked="@showNsfw" @onchange="ToggleShowNsfw" />
                Show NSFW
            </label>
        </div>

        <FilterBuilder State="filterState" OnChanged="OnFilterChanged"
            AvailableGenres="AvailableGenres"
            AvailableThemes="AvailableThemes"
            AvailableDemographics="AvailableDemographics"
            AllowDynamicExpressions="true" />
        <SortBuilder State="sortState" OnChanged="OnSortChanged" />
    </div>

    <div class="results-info">
        @if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            <span>@DisplayedAnimes.Count result@(DisplayedAnimes.Count != 1 ? "s" : "") for "@searchQuery"</span>
        }
        else if (activeCollectionId is not null)
        {
            <span>@DisplayedAnimes.Count of @totalCount anime shown from @ActiveCollectionName</span>
        }
        else if (filterState.IsActive || hideInLibrary || HasNsfwFilter)
        {
            <span>@DisplayedAnimes.Count of @allAnimes.Count loaded anime@(allAnimes.Count != 1 ? "s" : "") shown</span>
        }
        else
        {
            <span>@allAnimes.Count anime@(allAnimes.Count != 1 ? "s" : "") loaded</span>
        }
    </div>

    @if (isLoading && allAnimes.Count == 0)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Loading anime data...</p>
        </div>
    }
    else if (!isLoading && !isLoadingMore && DisplayedAnimes.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">&#x1F3AC;</span>
            <h3>No anime found</h3>
            <p>
                @if (activeCollectionId is not null)
                {
                    <text>No anime match the active options in @ActiveCollectionName.</text>
                }
                else if ((filterState.IsActive || hideInLibrary || HasNsfwFilter) && allAnimes.Count > 0)
                {
                    <text>No anime match the active filters. Try adjusting or clearing them.</text>
                }
                else if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <text>No results for "@searchQuery".</text>
                }
                else
                {
                    <text>No anime in the database yet.</text>
                }
            </p>
        </div>
    }
    else
    {
        <div class="anime-grid">
            @foreach (var anime in DisplayedAnimes)
            {
                <AnimeCard Anime="@anime" Draggable="true" OnDragStarted="StartCollectionDrag" OnDragEnded="EndCollectionDrag" />
            }
        </div>
    }

    @if (string.IsNullOrWhiteSpace(searchQuery))
    {
        @if (isLoadingMore)
        {
            <div class="loading-container" style="padding:1rem 0">
                <div class="spinner"></div>
            </div>
        }
        else if (!isLoading && hasMore)
        {
            <div style="display:flex;justify-content:center;padding:1.5rem 0">
                <button class="btn btn-primary" @onclick="LoadMore">
                    Load More
                </button>
            </div>
        }
    }
</div>

@code {
    private List<Anime> allAnimes = new();
    private FilterState filterState = new();
    private SortState sortState = new();
    private int pageSize = 100;
    private int totalCount = 0;
    private bool hasMore;
    private string searchQuery = string.Empty;
    private bool isLoading = false;
    private bool isLoadingMore = false;
    private bool _ownNavigation = false;
    private bool hideInLibrary;
    private bool showNsfw;
    private string? quickFilterPreset;
    private int? activeCollectionId;
    private List<AnimeCollection> homepageCollections = [];
    private string ActiveCollectionName => homepageCollections.FirstOrDefault(collection => collection.Id == activeCollectionId)?.Name ?? "this collection";
    private List<string> nsfwGenres = [];
    private List<string> nsfwThemes = [];

    private List<Anime> DisplayedAnimes => SortEngine.Apply(
            (filterState.IsActive && string.IsNullOrWhiteSpace(searchQuery) && !HasLibraryFilter
                ? allAnimes
                : FilterEngine.Apply(allAnimes, filterState, IsInLibrary))
            .Where(anime => !hideInLibrary || !IsInLibrary(anime))
            .Where(anime => showNsfw || !IsNsfw(anime))
            .ToList(),
        sortState, IsInLibrary);

    private void StartCollectionDrag(int animeId) => CollectionDragService.Start(animeId);
    private void EndCollectionDrag() => CollectionDragService.Clear();

    private bool HasLibraryFilter => filterState.Groups
        .SelectMany(g => g.Conditions)
        .Any(c => c.Field == FilterField.InLibrary && FilterState.IsActiveCondition(c));

    private bool HasNsfwFilter => !showNsfw;

    private bool IsInLibrary(Anime anime) =>
        MediaLibraryService.IsInSonarr(anime) || MediaLibraryService.IsInRadarr(anime);

    private bool IsNsfw(Anime anime) => NsfwFilterSettings.Matches(anime, nsfwGenres, nsfwThemes);

    private List<string> AvailableGenres { get; set; } = [];
    private List<string> AvailableThemes { get; set; } = [];
    private List<string> AvailableDemographics { get; set; } = [];

    // ── Lifecycle ────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        NavManager.LocationChanged += OnLocationChanged;
        homepageCollections = await CollectionService.GetHomepageAsync();
        await RestoreFromUrl(NavManager.Uri);
        await Task.WhenAll(LoadTagsAsync(), LoadNsfwFiltersAsync(), MediaLibraryService.EnsureRefreshedAsync());
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_ownNavigation) { _ownNavigation = false; return; }

        _ = InvokeAsync(async () =>
        {
            await RestoreFromUrl(e.Location);
            StateHasChanged();
        });
    }

    // ── URL ──────────────────────────────────────────────────

    private async Task RestoreFromUrl(string uri)
    {
        var qs = ParseQuery(uri);

        pageSize    = qs.TryGetValue("pageSize", out var ps) && int.TryParse(ps, out var psi) ? psi : 100;
        searchQuery = qs.GetValueOrDefault("q", string.Empty);
        hideInLibrary = qs.TryGetValue("hideInLibrary", out var hide) && hide == "1";
        showNsfw = qs.TryGetValue("showNsfw", out var show) && show == "1";
        quickFilterPreset = qs.GetValueOrDefault("preset") is { } preset && IsQuickFilterPreset(preset) ? preset : null;
        activeCollectionId = qs.TryGetValue("collection", out var collectionValue)
            && int.TryParse(collectionValue, out var collectionId)
            && homepageCollections.Any(collection => collection.Id == collectionId)
                ? collectionId
                : null;
        filterState = qs.TryGetValue("filters", out var f)
            ? DeserializeFilters(f) ?? new FilterState()
            : new FilterState();
        sortState   = qs.TryGetValue("sort", out var s)
            ? DeserializeSort(s) ?? new SortState()
            : new SortState();

        allAnimes  = new();
        totalCount = 0;
        hasMore = false;

        if (!string.IsNullOrWhiteSpace(searchQuery))
            await LoadSearch();
        else if (activeCollectionId is not null)
            await LoadCollectionFilter();
        else if (quickFilterPreset is not null)
            await LoadQuickFilter();
        else if (filterState.IsActive)
            await LoadFiltered();
        else
            await LoadRecent();
    }

    private void PushUrl(bool replace = false)
    {
        _ownNavigation = true;
        NavManager.NavigateTo(BuildUrl(), replace: replace);
    }

    private string BuildUrl()
    {
        var parts = new List<string>();
        if (pageSize != 100)
            parts.Add($"pageSize={pageSize}");
        if (!string.IsNullOrEmpty(searchQuery))
            parts.Add($"q={Uri.EscapeDataString(searchQuery)}");
        if (hideInLibrary)
            parts.Add("hideInLibrary=1");
        if (showNsfw)
            parts.Add("showNsfw=1");
        if (quickFilterPreset is not null)
            parts.Add($"preset={quickFilterPreset}");
        if (activeCollectionId is not null)
            parts.Add($"collection={activeCollectionId}");
        if (filterState.IsActive)
            parts.Add($"filters={Uri.EscapeDataString(SerializeFilters(filterState))}");
        if (sortState.IsActive)
            parts.Add($"sort={Uri.EscapeDataString(SerializeSort(sortState))}");
        return parts.Count == 0 ? "/" : "/?" + string.Join("&", parts);
    }

    private static Dictionary<string, string> ParseQuery(string uri)
    {
        var idx = uri.IndexOf('?');
        if (idx < 0) return new(StringComparer.OrdinalIgnoreCase);

        return uri[(idx + 1)..]
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Split('=', 2))
            .Where(p => p.Length == 2)
            .ToDictionary(
                p => Uri.UnescapeDataString(p[0]),
                p => Uri.UnescapeDataString(p[1]),
                StringComparer.OrdinalIgnoreCase);
    }

    // ── Data loading ─────────────────────────────────────────

    private async Task LoadRecent(bool append = false)
    {
        if (append) isLoadingMore = true;
        else isLoading = true;
        StateHasChanged();
        try
        {
            var skip  = append ? allAnimes.Count : 0;
            var items = await AnimeDataSource.GetRecentAsync(skip, pageSize + 1);
            hasMore = items.Count > pageSize;
            if (hasMore) items.RemoveAt(pageSize);
            totalCount = allAnimes.Count + items.Count;
            if (append) allAnimes.AddRange(items);
            else        allAnimes = items;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching anime: {ex.Message}");
            if (!append) allAnimes = new();
        }
        finally
        {
            isLoading = false;
            isLoadingMore = false;
            StateHasChanged();
        }
    }

    private async Task LoadFiltered(bool append = false)
    {
        if (append) isLoadingMore = true;
        else isLoading = true;
        StateHasChanged();
        try
        {
            if (HasLibraryFilter)
            {
                if (append) return;

                await MediaLibraryService.EnsureRefreshedAsync();
                var libraryFilterCandidates = await AnimeDataSource.GetFilteredAsync(new FilterState(), 0, int.MaxValue);
                allAnimes = FilterEngine.Apply(libraryFilterCandidates, CollectionFilterExpressionResolver.Resolve(filterState), IsInLibrary);
                totalCount = allAnimes.Count;
                hasMore = false;
                return;
            }

            var skip  = append ? allAnimes.Count : 0;
            var resolvedFilters = CollectionFilterExpressionResolver.Resolve(filterState);
            var items = await AnimeDataSource.GetFilteredAsync(resolvedFilters, skip, pageSize + 1);
            hasMore = items.Count > pageSize;
            if (hasMore) items.RemoveAt(pageSize);
            totalCount = allAnimes.Count + items.Count;
            if (append) allAnimes.AddRange(items);
            else        allAnimes = items;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching filtered anime: {ex.Message}");
            if (!append) allAnimes = new();
        }
        finally
        {
            isLoading = false;
            isLoadingMore = false;
            StateHasChanged();
        }
    }

    private async Task LoadTagsAsync()
    {
        try
        {
            // These methods share the circuit-scoped DbContext, so await each
            // before starting the next instead of issuing concurrent commands.
            AvailableGenres       = await AnimeDataSource.GetGenreNamesAsync();
            AvailableThemes       = await AnimeDataSource.GetThemeNamesAsync();
            AvailableDemographics = await AnimeDataSource.GetDemographicNamesAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tags: {ex.Message}");
        }
    }

    private async Task LoadSearch()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            allAnimes  = await AnimeDataSource.SearchAsync(searchQuery);
            totalCount = allAnimes.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching: {ex.Message}");
            allAnimes = new();
        }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task LoadMostFavorited(bool append = false)
    {
        if (append) isLoadingMore = true;
        else isLoading = true;
        StateHasChanged();
        try
        {
            var skip  = append ? allAnimes.Count : 0;
            var items = await AnimeDataSource.GetMostFavoritedAsync(skip, pageSize + 1);
            hasMore = items.Count > pageSize;
            if (hasMore) items.RemoveAt(pageSize);
            totalCount = allAnimes.Count + items.Count;
            if (append) allAnimes.AddRange(items);
            else        allAnimes = items;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading most favorited anime: {ex.Message}");
            if (!append) allAnimes = new();
        }
        finally
        {
            isLoading = false;
            isLoadingMore = false;
            StateHasChanged();
        }
    }

    private async Task LoadTopUpcoming(bool append = false)
    {
        if (append) isLoadingMore = true;
        else isLoading = true;
        StateHasChanged();
        try
        {
            var skip = append ? allAnimes.Count : 0;
            var items = await AnimeDataSource.GetTopUpcomingAsync(skip, pageSize + 1);
            hasMore = items.Count > pageSize;
            if (hasMore) items.RemoveAt(pageSize);
            totalCount = await AnimeDataSource.GetTopUpcomingCountAsync();
            if (append) allAnimes.AddRange(items);
            else allAnimes = items;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading top upcoming anime: {ex.Message}");
            if (!append) allAnimes = new();
        }
        finally
        {
            isLoading = false;
            isLoadingMore = false;
            StateHasChanged();
        }
    }

    private async Task LoadQuickFilter(bool append = false)
    {
        if (quickFilterPreset == "top-upcoming")
        {
            await LoadTopUpcoming(append);
            return;
        }

        if (append) isLoadingMore = true;
        else isLoading = true;
        StateHasChanged();
        try
        {
            var skip = append ? allAnimes.Count : 0;
            var items = await AnimeDataSource.GetQuickFilterAsync(quickFilterPreset!, skip, pageSize + 1);
            hasMore = items.Count > pageSize;
            if (hasMore) items.RemoveAt(pageSize);
            totalCount = await AnimeDataSource.GetQuickFilterCountAsync(quickFilterPreset!);
            if (append) allAnimes.AddRange(items);
            else allAnimes = items;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading {quickFilterPreset} anime: {ex.Message}");
            if (!append) allAnimes = new();
        }
        finally
        {
            isLoading = false;
            isLoadingMore = false;
            StateHasChanged();
        }
    }

    private async Task LoadCollectionFilter(bool append = false)
    {
        var collection = homepageCollections.FirstOrDefault(item => item.Id == activeCollectionId);
        if (collection is null) return;

        if (append) isLoadingMore = true;
        else isLoading = true;
        StateHasChanged();
        try
        {
            var skip = append ? allAnimes.Count : 0;
            var (items, count) = await CollectionService.GetAnimeSliceAsync(collection, skip, pageSize + 1);
            hasMore = items.Count > pageSize;
            if (hasMore) items.RemoveAt(pageSize);
            totalCount = count;
            if (append) allAnimes.AddRange(items);
            else allAnimes = items;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading collection {collection.Id}: {ex.Message}");
            if (!append) allAnimes = [];
        }
        finally
        {
            isLoading = false;
            isLoadingMore = false;
            StateHasChanged();
        }
    }

    // ── User actions ─────────────────────────────────────────

    private async Task LoadMore()
    {
        if (activeCollectionId is not null && string.IsNullOrWhiteSpace(searchQuery))
            await LoadCollectionFilter(append: true);
        else if (quickFilterPreset is not null && string.IsNullOrWhiteSpace(searchQuery))
            await LoadQuickFilter(append: true);
        else if (filterState.IsActive && string.IsNullOrWhiteSpace(searchQuery))
            await LoadFiltered(append: true);
        else
            await LoadRecent(append: true);
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size) || size == pageSize) return;
        pageSize   = size;
        allAnimes  = new();
        totalCount = 0;
        PushUrl(replace: true);
        if (activeCollectionId is not null)
            await LoadCollectionFilter();
        else if (quickFilterPreset is not null)
            await LoadQuickFilter();
        else if (filterState.IsActive)
            await LoadFiltered();
        else
            await LoadRecent();
    }

    private async Task OnFilterChanged()
    {
        quickFilterPreset = null;
        activeCollectionId = null;
        allAnimes  = new();
        totalCount = 0;
        PushUrl(replace: true);
        if (filterState.IsActive)
            await LoadFiltered();
        else
            await LoadRecent();
    }

    private async Task LoadNsfwFiltersAsync()
    {
        nsfwGenres = NsfwFilterSettings.Read(
            await SettingsService.GetAsync(NsfwFilterSettings.GenreSettingKey),
            NsfwFilterSettings.DefaultGenres);
        nsfwThemes = NsfwFilterSettings.Read(
            await SettingsService.GetAsync(NsfwFilterSettings.ThemeSettingKey),
            NsfwFilterSettings.DefaultThemes);
    }

    private void ToggleHideInLibrary(ChangeEventArgs e)
    {
        hideInLibrary = e.Value is bool value && value;
        PushUrl(replace: true);
        StateHasChanged();
    }

    private void ToggleShowNsfw(ChangeEventArgs e)
    {
        showNsfw = e.Value is bool value && value;
        PushUrl(replace: true);
        StateHasChanged();
    }

    private void OnSortChanged()
    {
        PushUrl(replace: true);
        StateHasChanged();
    }

    // ── Preset Filter Handlers ──────────────────────────────────────
    private async Task SetPresetAllAnime()
    {
        quickFilterPreset = null;
        activeCollectionId = null;
        filterState = new FilterState();
        sortState = new SortState();
        allAnimes = new();
        totalCount = 0;
        PushUrl(replace: true);
        if (!string.IsNullOrWhiteSpace(searchQuery)) await LoadSearch();
        else await LoadRecent();
    }

    private async Task SetPresetTopAiring()
    {
        quickFilterPreset = "top-airing";
