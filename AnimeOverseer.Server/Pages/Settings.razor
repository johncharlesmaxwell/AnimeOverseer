    private async Task LoadQualityProfilesAsync(bool sonarr)
    {
        var url = sonarr ? _sonarrUrl : _radarrUrl;
        var apiKey = sonarr ? _sonarrKey : _radarrKey;

        if (string.IsNullOrWhiteSpace(url) || string.IsNullOrWhiteSpace(apiKey))
        {
            SetProfileLoadError(sonarr, "Enter a URL and API key first.");
            return;
        }

        SetProfileLoadState(sonarr, true, null);
        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(10);
            client.DefaultRequestHeaders.Add("X-Api-Key", apiKey.Trim());
            var response = await client.GetAsync($"{NormalizeUrl(url)}/api/v3/qualityprofile");
            if (!response.IsSuccessStatusCode)
            {
                SetProfileLoadError(sonarr, $"Could not load profiles (HTTP {(int)response.StatusCode}).");
                return;
            }

            var profiles = await response.Content.ReadFromJsonAsync<List<QualityProfileOption>>() ?? [];
            if (sonarr) _sonarrQualityProfiles = profiles.OrderBy(p => p.Name).ToList();
            else _radarrQualityProfiles = profiles.OrderBy(p => p.Name).ToList();
        }
        catch (Exception ex)
        {
            SetProfileLoadError(sonarr, FormatException(ex));
        }
        finally
        {
            if (sonarr) _sonarrProfilesLoading = false;
            else _radarrProfilesLoading = false;
        }
    }

    private void SetProfileLoadState(bool sonarr, bool loading, string? error)
    {
        if (sonarr) { _sonarrProfilesLoading = loading; _sonarrProfilesError = error; }
        else { _radarrProfilesLoading = loading; _radarrProfilesError = error; }
    }

    private void SetProfileLoadError(bool sonarr, string error) => SetProfileLoadState(sonarr, false, error);

