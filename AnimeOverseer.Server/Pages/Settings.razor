    private async Task<(bool Ok, string Msg)> TestArrAsync(string url, string apiKey, string name)
    {
        if (string.IsNullOrWhiteSpace(url)) return (false, "URL is required");
        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(15); // Match the timeout used in actual service calls
            using var req = new HttpRequestMessage(HttpMethod.Get, $"{url}/api/v3/system/status");
            if (!string.IsNullOrWhiteSpace(apiKey))
                req.Headers.Add("X-Api-Key", apiKey);
            var res = await client.SendAsync(req);
            if (res.IsSuccessStatusCode) return (true, "Connected");

            var body = await SafeReadBodyAsync(res);
            var reason = string.IsNullOrWhiteSpace(res.ReasonPhrase) ? "" : $" {res.ReasonPhrase}";
            var detail = string.IsNullOrWhiteSpace(body) ? "" : $" — {body}";
            return (false, $"HTTP {(int)res.StatusCode}{reason}{detail}");
        }
        catch (HttpRequestException ex)
        {
            // Handle network-related errors specifically
            return (false, $"Network error: {ex.Message}");
        }
        catch (TaskCanceledException ex)
        {
            // Handle timeouts
            return (false, "Connection timed out - check if the URL is correct and the service is reachable");
        }
        catch (Exception ex)
        {
            // Handle all other exceptions
            return (false, $"Error: {ex.Message}");
        }
    }

    private static async Task<string> SafeReadBodyAsync(HttpResponseMessage res)
    {
        try
        {
            var body = await res.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body)) return string.Empty;
            body = body.Trim();
            const int max = 500;
            return body.Length > max ? body[..max] + "…" : body;
        }
        catch { return string.Empty; }
    }

    private static string FormatException(Exception ex)
    {
        var messages = new List<string>();
        for (var cur = ex; cur is not null; cur = cur.InnerException)
            if (!string.IsNullOrWhiteSpace(cur.Message))
                messages.Add(cur.Message.Trim());
        return messages.Count == 0 ? ex.GetType().Name : string.Join(" → ", messages);
    }

