    private IEnumerable<int> JikanYearList()
    {
        var current = DateTime.UtcNow.Year;
        var standard = Enumerable.Range(1960, current - 1960 + 2);
        return standard.Union(_jikanYears).OrderByDescending(y => y);
    }

    private bool IsValidCustomYear()
        => int.TryParse(_jikanCustomYear, out var y) && y >= 1900 && y <= 2200;

    private void AddCustomJikanYear()
    {
        if (int.TryParse(_jikanCustomYear, out var y) && y >= 1900 && y <= 2200)
        {
            _jikanYears.Add(y);
            _jikanCustomYear = "";
        }
    }

    private void OnCustomYearKeyDown(KeyboardEventArgs e)
